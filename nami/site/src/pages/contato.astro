---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/marketing.css";
---

<BaseLayout
  title="Contato | NAMI Works"
  description="Fale com a NAMI Works por e-mail para dúvidas gerais, parcerias ou qualquer assunto fora do Diagnóstico."
>
  <section class="section pageHero">
    <div class="container narrow">
      <p class="eyebrow">Contato</p>
      <h1 class="sectionTitle">Fale com a gente.</h1>
      <p class="lede">
        Para pedir o Diagnóstico, use o formulário na
        <a href="/diagnostico" class="inlineLink">página do Diagnóstico</a>.
        Para qualquer outro assunto, escreva por e-mail.
      </p>

      <div class="card contactCard">
        <p class="label">E-mail</p>
        <a href="mailto:contato@nami.works" class="value">contato@nami.works</a>
      </div>

      <div class="card contactCard">
        <p class="label">Onde estamos</p>
        <p class="value">Brasil, operação remota</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .pageHero {
    padding-top: 96px;
    padding-bottom: 96px;
  }

  .container.narrow {
    max-width: 560px;
  }

  .inlineLink {
    color: var(--site-accent);
    text-decoration: underline;
  }

  .contactCard {
    margin-top: 20px;
    display: grid;
    gap: 6px;
  }

  .label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--site-text-secondary);
    margin: 0;
  }

  .value {
    font-size: 17px;
    color: var(--site-text);
    text-decoration: none;
    margin: 0;
  }

  a.value:hover {
    color: var(--site-accent);
  }

  @media (min-width: 769px) {
    .pageHero {
      padding-top: 130px;
    }
  }
</style>
