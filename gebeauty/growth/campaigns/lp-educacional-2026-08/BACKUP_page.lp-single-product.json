          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>#shopify-section-{{ section.id }} .product{background:#ecede9 !important;border-radius:20px;overflow:hidden;padding:24px;align-items:center;}#shopify-section-{{ section.id }} .product-media-container,#shopify-section-{{ section.id }} .product__media-wrapper,#shopify-section-{{ section.id }} .product__info-container{background:transparent !important;}#shopify-section-{{ section.id }} .product__info-wrapper{align-self:center;}#shopify-section-{{ section.id }} .product__title{font-weight:700 !important;}#shopify-section-{{ section.id }} .product__view-details{display:none !important;}#shopify-section-{{ section.id }} .button{border-radius:40px !important;}#shopify-section-{{ section.id }} .icon-with-text__item img{width:60px !important;height:auto !important;}#shopify-section-{{ section.id }} #price-{{ section.id }},#shopify-section-{{ section.id }} .product__info-container > .no-js-hidden{display:none !important;}}\";display:flex;align-items:center;justify-content:center;gap:0.6em;}@media(min-width:750px){#shopify-section-{{ section.id }} .product__media-wrapper{max-width:80%;margin-inline:auto;}#shopify-section-{{ section.id }} .product__title{font-size:calc(var(--font-heading-scale) * 2.6rem + 4pt) !important;}#shopify-section-{{ section.id }} .icon-with-text__item img{width:80px !important;}}<\/style><style>\/* iwt-card *\/.image-with-text__grid{background:#ecede9 !important;border-radius:20px;overflow:hidden;padding:24px;align-items:center;}.image-with-text__media,.image-with-text__content{background:transparent !important;}<\/style><style>\/* iwt-card-mobile *\/@media(max-width:749px){.image-with-text__grid{padding:0 !important;}.image-with-text__media{border-radius:0 !important;}.image-with-text__content{padding-left:16px !important;padding-right:16px !important;}}<\/style><style>\/* iwt-card-desktop *\/@media(min-width:750px){.image-with-text__grid{padding:0 !important;align-items:stretch !important;}.image-with-text__media{height:100% !important;}.image-with-text__media img{height:100% !important;width:100% !important;object-fit:cover !important;}.image-with-text__content{padding:32px !important;}}<\/style>"
          }
