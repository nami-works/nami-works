// CloudFront Function — viewer-request handler for b2b.gebeauty.com.br.
//
// Two jobs in one function, because a cache behavior only accepts one
// function per event type:
//   1. HTTP Basic Auth gate. These are unlisted sell-in decks, not secrets
//      (handoff decision: "light access gate", single shared credential) --
//      just enough friction to keep them out of search/predictive-search and
//      off random crawlers, not a real authz boundary.
//   2. Clean-URL rewrite: "/comercial" -> "/comercial/index.html" (same
//      pattern as nami/site's site-url-rewrite.js, adapted for this site's
//      fixed two-route layout instead of an Astro build tree). Root "/"
//      redirects to "/comercial/" -- the wholesale audience is the default
//      landing target; confirm with Lucas if the neutral/partner deck should
//      be the default instead.
//
// The credential is injected at `terraform apply` time via templatefile()
// (see site.tf) from a Terraform variable -- NEVER hardcode plaintext here;
// this .tftpl file is a template, not the deployed function body, and stays
// safe to commit.
var EXPECTED_AUTH = 'Basic ${basic_auth_b64}';

function handler(event) {
  var request = event.request;

  // ── 1. Basic Auth gate ──────────────────────────────────────────────────
  var headers = request.headers;
  var authHeader = headers.authorization && headers.authorization.value;
  if (authHeader !== EXPECTED_AUTH) {
    return {
      statusCode: 401,
      statusDescription: 'Unauthorized',
      headers: {
        'www-authenticate': { value: 'Basic realm="GE Beauty B2B", charset="UTF-8"' },
      },
    };
  }

  // ── 2. Clean-URL rewrite + root redirect ────────────────────────────────
  var uri = request.uri;

  if (uri === '/') {
    return {
      statusCode: 302,
      statusDescription: 'Found',
      headers: { location: { value: '/comercial/' } },
    };
  }

  if (uri.endsWith('/')) {
    request.uri = uri + 'index.html';
    return request;
  }

  var lastSegment = uri.substring(uri.lastIndexOf('/') + 1);
  if (lastSegment.length > 0 && !lastSegment.includes('.')) {
    request.uri = uri + '/index.html';
  }

  return request;
}
