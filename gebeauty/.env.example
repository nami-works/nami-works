# Populate this file by running:
#   npx tsx scripts/ssm-to-env.ts --tenant gebeauty
#
# Do NOT commit .env. Only .env.example is tracked.

# Shopify store identity (static — safe defaults shown)
SHOPIFY_SHOP_NAME=ge-beauty-cosmeticos
SHOPIFY_SHOP_DOMAIN=ge-beauty-cosmeticos.myshopify.com
SHOPIFY_API_VERSION=2026-01

# Shopify access token — from /nami-works/tenants/gebeauty/shopify/access_token
SHOPIFY_ADMIN_ACCESS_TOKEN=

# cpg-labs Control API — for cpg_control.py two-phase close / mark-delivered
# URL is the deployed cpg-labs backend; token is /nami-works/tenants/gebeauty/cpg-labs/control_token
CPG_LABS_CONTROL_URL=https://omnify.cpg-labs.io
CPG_LABS_CONTROL_TOKEN=
