---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="CPG Labs — Page not found"
  description="The page you were looking for doesn't exist. Head back to cpg-labs.io to find what you need."
>
  <main class="page">
    <div class="content">
      <p class="eyebrow">404</p>
      <h1 class="title">Page not found.</h1>
      <p class="subtitle">
        The page you were looking for moved, was renamed, or never existed.
        Head back to the home page to find what you need.
      </p>
      <a href="/" class="cta">← Back to CPG Labs</a>
    </div>
  </main>
</BaseLayout>

<style>
  .page {
    min-height: calc(100vh - 200px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 16px;
  }

  .content {
    max-width: 480px;
    text-align: center;
  }

  .eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--site-text-secondary);
    margin: 0 0 12px;
  }

  .title {
    font-size: 32px;
    font-weight: 700;
    color: var(--site-text);
    margin: 0 0 16px;
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 16px;
    line-height: 1.6;
    color: var(--site-text-secondary);
    margin: 0 0 32px;
  }

  .cta {
    display: inline-block;
    color: var(--site-text);
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
    border-bottom: 1px solid var(--site-border);
    padding-bottom: 4px;
    transition: border-color 0.15s ease;
  }

  .cta:hover {
    border-bottom-color: var(--site-text);
  }

  @media (min-width: 769px) {
    .title {
      font-size: 48px;
    }
    .subtitle {
      font-size: 18px;
    }
  }
</style>
