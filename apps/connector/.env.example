NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/nami_works?schema=public
# Separate logical DB for the nami.works matchmaking funnel (same Postgres
# server, own database -- see prisma/nami-matchmaking/schema.prisma).
DATABASE_URL_NAMI_MATCHMAKING=postgresql://postgres:postgres@localhost:5433/nami_matchmaking?schema=public
# Allowed origin for the matchmaking funnel's public form-submit route
# (the only CORS-enabled route in this app -- see src/matchmaking/index.ts).
MATCHMAKING_ALLOWED_ORIGIN=https://nami.works

AWS_REGION=us-east-1
SSM_NAMESPACE=/nami-works
