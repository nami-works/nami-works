{
  "name": "cpg-labs",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "node server.mjs",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc --noEmit && npm run check:basepath && npm run check:site-deps",
    "check:basepath": "node --import tsx scripts/check-no-basepath-in-nav-links.ts",
    "check:site-deps": "node --import tsx scripts/check-site-deps.ts",
    "seed:local-delivery": "node --import tsx scripts/seed-local-delivery-orders.ts",
    "sample-rates:refresh-monthly": "node --import tsx scripts/refresh-sample-rates-monthly.ts",
    "debug:delivery-profiles": "node --import tsx scripts/debug-delivery-profiles.ts",
    "inventory:activate-locations": "node --import tsx scripts/activate-location-inventory.ts",
    "i18n:validate": "node --import tsx scripts/i18n-validate.ts",
    "i18n:scan": "node --import tsx scripts/i18n-scan.ts",
    "test:i18n": "node --import tsx tests/i18n.test.ts",
    "test": "node --import tsx --test tests/webhooks.test.ts",
    "test:lalamove-security": "node --import tsx --test tests/lalamove-encryption.test.ts tests/lalamove-credentials.test.ts",
    "webhook:listen": "node --import tsx scripts/webhook-listen.ts"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@aws-sdk/client-s3": "^3.1044.0",
    "@cpg-labs/shared-auth": "workspace:*",
    "@cpg-labs/shared-db": "workspace:*",
    "@cpg-labs/shared-encryption": "workspace:*",
    "@cpg-labs/shared-google-routes": "workspace:*",
    "@cpg-labs/shared-i18n": "workspace:*",
    "@cpg-labs/shared-ui": "workspace:*",
    "@cpg-labs/shared-webhooks": "workspace:*",
    "@prisma/client": "^6.16.3",
    "@react-router/dev": "^7.12.0",
    "@react-router/express": "^7.12.0",
    "@react-router/fs-routes": "^7.12.0",
    "@react-router/node": "^7.12.0",
    "@react-router/serve": "^7.12.0",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^1.1.0",
    "@shopify/shopify-app-session-storage-prisma": "^8.0.0",
    "compression": "^1.7.4",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "i18next": "^25.8.14",
    "isbot": "^5.1.31",
    "mammoth": "^1.12.0",
    "morgan": "^1.10.0",
    "prisma": "^6.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.6",
    "react-router": "^7.12.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@shopify/api-codegen-preset": "^1.2.0",
    "@shopify/polaris-types": "^1.0.1",
    "@types/eslint": "^9.6.1",
    "@types/google.maps": "^3.64.0",
    "@types/node": "^22.18.8",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "graphql-config": "^5.1.1",
    "prettier": "^3.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.6"
  },
  "workspaces": [
    "packages/*",
    "extensions/*",
    "price-tags"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "p-map": "^4.0.0"
  },
  "author": "Lucas Guimarães"
}
