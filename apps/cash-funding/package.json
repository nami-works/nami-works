{
  "name": "@nami/cash-funding",
  "version": "0.1.0",
  "description": "GE Beauty invoice-discounting (antecipação de recebíveis) simulator + allocation engine",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx ../../prisma/cash-funding/seed.ts"
  },
  "prisma": {
    "schema": "../../prisma/cash-funding/schema.prisma"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/sensible": "^6.0.2",
    "@fastify/static": "^8.0.4",
    "@prisma/client": "^6.1.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.0",
    "jose": "^6.2.2",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
