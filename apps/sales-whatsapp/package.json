{
  "name": "@nami/sales-whatsapp",
  "version": "0.1.0",
  "private": true,
  "description": "GE Beauty retail sales WhatsApp worklist — live credit-holder outreach, replacing the manual Excel export",
  "type": "module",
  "prisma": {
    "schema": "../../prisma/sales-whatsapp/schema.prisma"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev",
    "start": "node server.mjs",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "test": "vitest run",
    "typecheck": "react-router typegen && tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@react-router/dev": "^7.12.0",
    "@react-router/express": "^7.12.0",
    "@react-router/fs-routes": "^7.12.0",
    "@react-router/node": "^7.12.0",
    "@react-router/serve": "^7.12.0",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^1.1.0",
    "@shopify/shopify-app-session-storage-prisma": "^8.0.0",
    "compression": "^1.7.5",
    "express": "^4.21.2",
    "isbot": "^5.1.22",
    "morgan": "^1.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.12.0"
  },
  "devDependencies": {
    "@shopify/polaris-types": "^1.0.1",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "prisma": "^6.16.3",
    "typescript": "^5.7.0",
    "vite": "^6.3.6",
    "vitest": "^2.1.8"
  }
}
