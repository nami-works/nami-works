{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@prisma/client-sales-whatsapp": ["../../node_modules/@prisma/client-sales-whatsapp"]
    }
  },
  "include": ["worker/**/*.ts", "app/lib/**/*.ts", "app/shopify.server.ts", "app/db.server.ts"],
  "exclude": ["node_modules", "app/lib/__tests__/**", "**/*.test.ts"]
}
