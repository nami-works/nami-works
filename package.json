{
  "name": "nami-works",
  "version": "0.1.0",
  "description": "NAMI Works monorepo: MCP connector (mcp.nami.works) + Omnify family apps (cpg-labs.io).",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/connector",
    "apps/omnify-admin",
    "apps/omnify-site",
    "packages/letterbox",
    "packages/shared-auth",
    "packages/shared-db",
    "packages/shared-encryption",
    "packages/shared-google-routes",
    "packages/shared-i18n",
    "packages/shared-ui",
    "packages/shared-webhooks"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "vite": "6.4.2"
  },
  "scripts": {
    "dev": "npm run dev -w @nami/connector",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w @nami/connector",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate -w @nami/connector",
    "prisma:migrate": "npm run prisma:migrate -w @nami/connector",
    "prisma:deploy": "npm run prisma:deploy -w @nami/connector",
    "provision-tenant": "tsx scripts/provision-tenant.ts",
    "rotate-bearer": "tsx scripts/rotate-bearer.ts",
    "suspend-tenant": "tsx scripts/suspend-tenant.ts",
    "replace-shopify-files": "tsx scripts/replace-shopify-files.ts",
    "instagram-dump": "tsx scripts/instagram-dump.ts",
    "instagram-voice-card": "tsx scripts/instagram-voice-card.ts",
    "link-instagram": "tsx scripts/link-instagram.ts",
    "feedback-review": "tsx scripts/feedback-review.ts"
  }
}
