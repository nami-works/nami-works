{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(*)",
      "WebFetch",
      "WebSearch",
      "Agent",
      "TodoWrite",
      "NotebookEdit",
      "mcp__*",
      "mcp__shopify-dev-mcp__validate_graphql_codeblocks"
    ],
    "additionalDirectories": [
      "C:\\Users\\Lucas Guimarães\\.claude\\projects\\c--Users-Lucas-Guimar-es-Desktop-nami-works\\memory"
    ]
  },
  "enabledPlugins": {
    "shopify-plugin@shopify-ai-toolkit": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-commit-gates.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start-status.sh"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "shopify-ai-toolkit": {
      "source": {
        "source": "github",
        "repo": "Shopify/shopify-ai-toolkit"
      }
    }
  }
}
