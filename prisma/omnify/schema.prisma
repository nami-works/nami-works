// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model GoalsConfig {
  id        String   @id @default(cuid())
  shop      String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GoalsRun {
  id         String   @id @default(cuid())
  shop       String
  rangeKey   String
  configHash String
  data       Json
  createdAt  DateTime @default(now())

  @@index([shop, createdAt])
  @@index([shop, rangeKey, configHash])
}

model SalesGoalsConfig {
  id        String   @id @default(cuid())
  shop      String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SalesGoalsLocationConfig {
  id         String   @id @default(cuid())
  shop       String
  locationId String
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([shop, locationId])
}

model BenchmarkLaunch {
  id           String   @id @default(cuid())
  shop         String
  productId    String
  productTitle String?
  firstSoldAt  DateTime?
  computedAt   DateTime @default(now())

  @@unique([shop, productId])
  @@index([shop, computedAt])
}

model LalamoveLocationConfig {
  id         String   @id @default(cuid())
  shop       String
  locationId String
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([shop, locationId])
  @@index([shop])
}

model LalamoveShopCredential {
  id               String   @id @default(cuid())
  shop             String   @unique
  apiKeyCiphertext String
  apiSecretCiphertext String
  keyVersion       Int      @default(1)
  lastValidatedAt  DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([shop])
}

model CarrierServiceRegistration {
  id                String   @id @default(cuid())
  shop              String   @unique
  carrierServiceId  String
  callbackUrl       String
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([shop])
}

model CarrierServiceConfig {
  id        String   @id @default(cuid())
  shop      String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop])
}

model CarrierRateSample {
  id                 String   @id @default(cuid())
  shop               String
  locationId         String
  provider           String
  quadrantNorthIndex Int
  quadrantEastIndex  Int
  priceSubunits      Int
  currency           String
  fetchedAt          DateTime @default(now())

  @@unique([shop, locationId, provider, quadrantNorthIndex, quadrantEastIndex])
  @@index([shop, locationId])
}

model LalamoveDispatchJob {
  id                String   @id @default(cuid())
  shop              String
  routeId           String
  locationId        String
  status            String
  quotationId       String?
  lalamoveOrderId   String?
  market            String?
  serviceType       String?
  requestedBy       String?
  requestedAt       DateTime @default(now())
  priorityFeeLevel  Int      @default(0)   // 0=none applied, 1=first fee, 2=second fee, 3=third fee
  quotationTotal       String?               // snapshot of priceBreakdown.total at dispatch time
  quotationCurrency    String?               // snapshot of priceBreakdown.currency at dispatch time
  shopifyFulfillmentId String?               // Shopify fulfillment GID created at dispatch time
  retryCount        Int      @default(0)     // number of auto-retry attempts
  lastRetryAt       DateTime?                // timestamp of last auto-retry
  /// Snapshot of order stops at dispatch time so escalation reorder does not depend on PendingDeliveryRoute.
  /// Shape: Array<{ shopifyOrderId: string; lat: number; lng: number; address: string; name: string; phone: string }>
  ordersData        Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([shop, routeId])
  @@index([shop, status])
}

model LalamoveDispatchOrderMap {
  id                String   @id @default(cuid())
  shop              String
  dispatchJobId     String
  shopifyOrderId    String
  lalamoveOrderId   String?
  currentStatus     String?
  failureReason     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([shop, dispatchJobId, shopifyOrderId])
  @@index([shop, shopifyOrderId])
  @@index([shop, lalamoveOrderId])
}

model PendingDeliveryRoute {
  id         String   @id @default(cuid())
  shop       String
  locationId String
  routeId    String   @unique @default(cuid())
  /// "open" | "dispatched" | "cancelled"
  status     String
  /// Array<{ shopifyOrderId: string; lat: number; lng: number; address: string; name: string; phone: string }>
  ordersData Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([shop, status])
  @@index([shop, locationId, status])
}

model AutoAssignLog {
  id          String    @id @default(cuid())
  shop        String
  orderId     String
  orderName   String?
  /// Fulfillment location GID when known; null for skips before location is determined
  locationId   String?
  /// "assigned" | "skipped" | "error"
  status      String
  reason      String?
  /// Debug details: { soloPrice, jointPrice, routeId, deliveryMethod, error, etc. }
  details     Json?
  createdAt   DateTime  @default(now())

  @@index([shop, createdAt])
  @@index([shop, locationId, createdAt])
}

model LalamoveDispatchEvent {
  id                String   @id @default(cuid())
  shop              String
  dispatchJobId     String?
  shopifyOrderId    String?
  lalamoveOrderId   String?
  eventType         String
  externalStatus    String?
  payload           Json?
  processedAt       DateTime @default(now())
  createdAt         DateTime @default(now())

  @@index([shop, lalamoveOrderId])
  @@index([shop, shopifyOrderId])
  @@index([shop, eventType])
}

model RetailCurrentLocations {
  shop       String   @unique
  locations  Json     @default("[]")
  updatedAt  DateTime @updatedAt
}

model RetailLocationSet {
  id         String   @id @default(cuid())
  shop       String
  name       String
  locations  Json
  createdAt  String
  updatedAt  DateTime @updatedAt

  @@index([shop])
}

model RetailAnalyticsCache {
  shop       String   @unique
  customers  Json     @default("[]")
  orders     Json     @default("[]")
  updatedAt  DateTime @updatedAt
}

model RetailAnalyticsSyncStatus {
  shop               String    @unique
  status             String    @default("idle")
  errorMessage       String?
  phase              String?
  progressCount      Int?
  startedAt          DateTime?
  lastCustomersTotal Int?
  lastOrdersTotal    Int?
  updatedAt          DateTime  @updatedAt
}


model RetailLocationProposal {
  id            String   @id @default(cuid())
  shop          String
  locationSetId String
  locationId    String
  leasingValue  Float?
  currency      String?
  notes         String?
  fileName      String?
  fileType      String?
  fileSize      Int?
  fileData      Bytes?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([shop, locationSetId])
  @@index([shop, locationId])
}

model RetailStatsConfig {
  id        String   @id @default(cuid())
  shop      String
  setId     String?
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, setId])
  @@index([shop])
}

model PriceTagConfig {
  id                      String   @id @default(cuid())
  shop                    String   @unique
  discountMode            String   @default("highest")
  dollarThreshold         Float?
  metaobjectType          String   @default("")
  metafieldNamespace      String   @default("")
  metafieldKey            String   @default("")
  displayNameKey          String   @default("")
  metaobjectFieldDefaults String   @default("{}")
  webhookSyncEnabled      Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model PriceTagTierRule {
  id                 String   @id @default(cuid())
  shop               String
  discountType       String   @default("percent")
  startingAt         Float
  metaobjectHandles  String   @default("[]")
  metaobjectGids     String   @default("[]")
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([shop])
}

model PriceTagProductLog {
  id               String   @id @default(cuid())
  shop             String
  productGid       String
  metafieldSet     Boolean  @default(false)
  lastTierHandle   String?
  lastProcessedAt  DateTime @default(now())

  @@unique([shop, productGid])
  @@index([shop])
}

model BrandAssets {
  id                    String   @id @default(cuid())
  shop                  String   @unique
  about                 String?
  toneOfVoice           String?
  brandName             String?
  blogUrl               String?
  preferredLanguage     String?
  contentLanguage       String?
  benchmarks            String?
  brandCategory         String?
  editorialGuidelines   String?
  formatRecommendations String?
  contentStrategyJson   String?
  exportVersion         Int      @default(1)
  lastExportedAt        DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  learnings             BrandLearning[]

  @@map("BrandSettings")
}

model BrandLearning {
  id              String      @id @default(cuid())
  shop            String
  brandAssetsId   String
  brandAssets     BrandAssets @relation(fields: [brandAssetsId], references: [id], onDelete: Cascade)
  sourceArticleId String?
  sourceDiffId    String?
  category        String
  beforeSnippet   String
  afterSnippet    String
  interpretation  String
  status          String      @default("accepted")
  acceptedAt      DateTime    @default(now())
  createdAt       DateTime    @default(now())

  @@index([shop, status])
  @@index([brandAssetsId])
}

model BlogPostDiff {
  id               String    @id @default(cuid())
  shop             String
  draftId          String
  shopifyArticleId String
  detectedAt       DateTime  @default(now())
  beforeHtml       String
  afterHtml        String
  hypotheses       Json
  status           String    @default("pending_review")
  reviewedAt       DateTime?

  @@index([shop, status])
  @@index([shopifyArticleId])
}

model BlogPostJob {
  id           String    @id @default(cuid())
  shop         String
  jobId        String    @unique
  status       String
  briefJson    String?
  errorMessage String?
  resultJson   Json?
  lastPolledAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([shop, status])
  @@index([shop, createdAt])
}

model BlogPostDraft {
  id               String    @id @default(cuid())
  shop             String
  jobId            String
  themeKey         String
  title            String
  bodyHtml         String
  metaTitle        String?
  metaDescription  String?
  shopifyArticleId String?
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())

  @@unique([shop, jobId, themeKey])
  @@index([shop, shopifyArticleId])
}

model ReturnPickupRequest {
  id                 String   @id @default(cuid())
  shop               String
  shopifyOrderId     String
  shopifyOrderName   String?
  locationId         String
  customerName       String?
  customerPhone      String?
  customerAddress    String?
  customerAddress2   String?
  customerLat        Float?
  customerLng        Float?
  status             String   @default("pending")
  returnInstructions String?
  quotationId        String?
  lalamoveOrderId    String?
  quotationTotal     String?
  quotationCurrency  String?
  requestedBy        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([shop, shopifyOrderId])
  @@index([shop, status])
  @@index([shop, locationId, status])
}

// ─── Retail Footprint: Normalized analytics tables ────────────────────────────

model RetailOrder {
  id           String    @id
  shop         String
  customerId   String?
  city         String?
  cityNorm     String?
  latitude     Float?
  longitude    Float?
  totalAmount            Float?
  currencyCode           String?
  fulfillmentLocationId  String?
  orderDate              DateTime?
  syncedAt               DateTime  @default(now())

  @@index([shop, orderDate])
  @@index([shop, cityNorm])
  @@index([shop, latitude, longitude])
  @@index([shop, fulfillmentLocationId])
}

model RetailCustomer {
  id           String    @id
  shop         String
  city         String?
  cityNorm     String?
  latitude     Float?
  longitude    Float?
  customerDate DateTime?
  syncedAt     DateTime  @default(now())

  @@index([shop, customerDate])
  @@index([shop, cityNorm])
}

model RetailCityMonthly {
  id              String @id @default(cuid())
  shop            String
  cityNorm        String
  cityDisplay     String
  month           String
  orderCount      Int    @default(0)
  revenue         Float  @default(0)
  uniqueCustomers Int    @default(0)
  currencyCode    String?
  latitudeSum     Float  @default(0)
  longitudeSum    Float  @default(0)
  geocodedCount   Int    @default(0)

  @@unique([shop, cityNorm, month])
  @@index([shop, month])
}

model RetailHeatmapBucket {
  id            String @id @default(cuid())
  shop          String
  lat3          Float
  lng3          Float
  orderCount    Int    @default(0)
  revenueSum    Float  @default(0)
  customerCount Int    @default(0)

  @@unique([shop, lat3, lng3])
  @@index([shop])
}

model RetailSyncMeta {
  shop             String    @unique
  status           String    @default("idle")
  errorMessage     String?
  phase            String?
  progressCount    Int?
  startedAt        DateTime?
  lastSyncedAt     DateTime?
  lastOrderDate    DateTime?
  lastCustomerDate DateTime?
  totalOrders      Int?
  totalCustomers   Int?
  updatedAt        DateTime  @updatedAt
}

// ─── Affiliates: Normalized analytics tables ─────────────────────────────────

model AffiliateProfile {
  id              String   @id @default(cuid())
  shop            String
  code            String
  email           String?
  firstName       String?
  lastName        String?
  affiliateName   String
  instagram       String?
  tiktok          String?
  city            String?
  state           String?
  program         String?
  referralCode    String?
  commissionPct   Float    @default(10)
  tier            String   @default("baseline")
  status          String   @default("active")
  paymentMethod   String?
  paymentInfo     String?
  bixgrowCreatedAt DateTime?
  lastLogin       DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([shop, code])
  @@index([shop, status])
}

model AffiliateOrder {
  id               String    @id
  shop             String
  orderName        String?
  customerId       String?
  customerName     String?
  customerEmail    String?
  affiliateCode    String
  discountAmount   Float     @default(0)
  affiliateDiscount Float    @default(0)
  siteDiscount     Float     @default(0)
  totalAmount      Float     @default(0)
  subtotalAmount   Float     @default(0)
  currencyCode     String?
  isFirstOrder     Boolean   @default(false)
  itemCount        Int       @default(0)
  lineItemsJson    String?
  orderDate        DateTime?
  syncedAt         DateTime  @default(now())

  @@index([shop, orderDate])
  @@index([shop, affiliateCode])
  @@index([shop, customerId])
  @@index([shop, affiliateCode, orderDate])
}

model AffiliateOrganicAgg {
  id              String @id @default(cuid())
  shop            String
  month           String
  orderCount      Int    @default(0)
  revenue         Float  @default(0)
  subtotal        Float  @default(0)
  siteDiscountTotal Float @default(0)
  uniqueCustomers Int    @default(0)
  newCustomers    Int    @default(0)
  repeatCustomers Int    @default(0)
  avgOrderValue   Float  @default(0)
  currencyCode    String?

  @@unique([shop, month])
  @@index([shop])
}

model AffiliateMonthly {
  id              String @id @default(cuid())
  shop            String
  affiliateCode   String
  month           String
  orderCount      Int    @default(0)
  revenue         Float  @default(0)
  subtotal        Float  @default(0)
  affiliateDiscountTotal Float @default(0)
  siteDiscountTotal      Float @default(0)
  commissionTotal Float  @default(0)
  uniqueCustomers Int    @default(0)
  newCustomers    Int    @default(0)
  repeatCustomers Int    @default(0)
  avgOrderValue   Float  @default(0)
  currencyCode    String?

  @@unique([shop, affiliateCode, month])
  @@index([shop, month])
  @@index([shop, affiliateCode])
}

model AffiliateSyncMeta {
  shop                 String    @unique
  status               String    @default("idle")
  errorMessage         String?
  phase                String?
  progressCount        Int?
  startedAt            DateTime?
  lastSyncedAt         DateTime?
  lastOrderCursor      String?
  totalOrders          Int?
  totalAffiliateOrders Int?
  updatedAt            DateTime  @updatedAt
}

model GeocodeCacheEntry {
  id        String   @id @default(cuid())
  queryKey  String   @unique
  lat       Float
  lng       Float
  route     String?
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model RoutePolylineCache {
  id             String   @id @default(cuid())
  shop           String
  locationId     String
  orderIdsKey    String   // sorted order IDs joined by "|"
  encodedPolyline String
  createdAt      DateTime @default(now())

  @@unique([shop, locationId, orderIdsKey])
  @@index([shop, locationId])
}

model BulkPriceCampaign {
  id              String    @id @default(cuid())
  shop            String
  name            String
  status          String    @default("draft")
  discountType    String    @default("percentage")
  discountValue   Float
  filterType      String    @default("product_types")
  filterValues    String    @default("[]")
  excludeEnabled  Boolean   @default(false)
  excludeType     String    @default("tags")
  excludeValues   String    @default("[]")
  startAt         DateTime
  endAt           DateTime?
  activatedAt     DateTime?
  deactivatedAt   DateTime?
  productCount    Int       @default(0)
  variantCount    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  priceTagsEnabled           Boolean  @default(false)
  priceTagMetaobjectType     String?
  priceTagDisplayNameKey     String?
  priceTagFieldDefaults      String?
  priceTagMetafieldNamespace String?
  priceTagMetafieldKey       String?

  items BulkPriceCampaignItem[]

  @@index([shop])
  @@index([shop, status])
}

model BulkPriceCampaignItem {
  id                     String   @id @default(cuid())
  campaignId             String
  shop                   String
  productGid             String
  variantGid             String
  originalPrice          Float
  originalCompareAtPrice Float?
  appliedPrice           Float
  appliedCompareAtPrice  Float
  createdAt              DateTime @default(now())

  campaign BulkPriceCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([shop, variantGid])
}

model RouteOptimizationSnapshot {
  id               String   @id @default(cuid())
  shop             String
  locationId       String
  proposedAt       DateTime @default(now())
  /// Array<{ routeIndex, orderIds, serviceType, costSubunits }>
  proposedRoutes   Json
  /// Array<{ orderId, lat, lng }> for geographic analysis
  orderCoordinates Json
  orderCount       Int
  routeCount       Int

  @@index([shop, locationId, proposedAt])
}

model RouteCorrection {
  id                   String   @id @default(cuid())
  shop                 String
  snapshotId           String
  dispatchedAt         DateTime @default(now())
  dispatchedRouteIndex Int?
  /// Array<{ orderId, fromRoute, toRoute, lat, lng }>
  corrections          Json
  wasModified          Boolean
  ordersReassigned     Int
  ordersDispatched     Int

  @@index([shop, dispatchedAt])
  @@index([snapshotId])
}

model WaitlistSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("gbp-health-check")
  createdAt DateTime @default(now())
}