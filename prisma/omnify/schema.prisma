model AffiliateProfile {
  id               String    @id @default(cuid())
  shop             String
  code             String
  email            String?
  firstName        String?
  lastName         String?
  affiliateName    String
  instagram        String?
  tiktok           String?
  city             String?
  state            String?
  program          String?
  referralCode     String?
  commissionPct    Float     @default(10)
  tier             String    @default("baseline")
  status           String    @default("active")
  paymentMethod    String?
  paymentInfo      String?
  bixgrowCreatedAt DateTime?
  lastLogin        DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([shop, code])
  @@index([shop, status])
}

model AffiliateOrder {
  id                     String    @id
  shop                   String
  orderName              String?
  customerId             String?
  customerName           String?
  customerEmail          String?
  affiliateCode          String
  discountAmount         Float     @default(0)
  affiliateDiscount      Float     @default(0)
  siteDiscount           Float     @default(0)
  totalAmount            Float     @default(0)
  subtotalAmount         Float     @default(0)
  currencyCode           String?
  // True when the customer had a prior order with the shop before this
  // order's createdAt (organic or via another affiliate). Set at sync time
  // from Shopify's customer.firstOrder — see sync.server.ts. Replaces
  // the earlier isFirstOrder column whose semantics were ambiguous.
  wasPreExistingCustomer Boolean   @default(false)
  itemCount              Int       @default(0)
  lineItemsJson          String?
  orderDate              DateTime?
  syncedAt               DateTime  @default(now())

  @@index([shop, orderDate])
  @@index([shop, affiliateCode])
  @@index([shop, customerId])
  @@index([shop, affiliateCode, orderDate])
}

model AffiliateOrganicAgg {
  id                String  @id @default(cuid())
  shop              String
  month             String
  orderCount        Int     @default(0)
  revenue           Float   @default(0)
  subtotal          Float   @default(0)
  siteDiscountTotal Float   @default(0)
  uniqueCustomers   Int     @default(0)
  newCustomers      Int     @default(0)
  repeatCustomers   Int     @default(0)
  avgOrderValue     Float   @default(0)
  currencyCode      String?

  @@unique([shop, month])
  @@index([shop])
}

// Per-customer organic orders (no affiliate coupon). Enables cohort LTV
// and future per-customer analytics for customers untouched by affiliates.
// Populated at sync time alongside the AffiliateOrganicAgg rebuild.
model OrganicOrder {
  id                     String    @id
  shop                   String
  orderName              String?
  customerId             String?
  customerName           String?
  customerEmail          String?
  totalAmount            Float     @default(0)
  subtotalAmount         Float     @default(0)
  discountAmount         Float     @default(0)
  currencyCode           String?
  // Classified at sync time via customer.numberOfOrders + createdAt
  // (same rule as AffiliateOrder.wasPreExistingCustomer). `false` means
  // this row is the customer's first-ever purchase with the shop.
  wasPreExistingCustomer Boolean   @default(false)
  itemCount              Int       @default(0)
  orderDate              DateTime?
  syncedAt               DateTime  @default(now())

  @@index([shop, orderDate])
  @@index([shop, customerId])
  @@index([shop, customerId, orderDate])
}

model AffiliateMonthly {
  id                     String  @id @default(cuid())
  shop                   String
  affiliateCode          String
  month                  String
  orderCount             Int     @default(0)
  revenue                Float   @default(0)
  subtotal               Float   @default(0)
  affiliateDiscountTotal Float   @default(0)
  siteDiscountTotal      Float   @default(0)
  commissionTotal        Float   @default(0)
  uniqueCustomers        Int     @default(0)
  newCustomers           Int     @default(0)
  repeatCustomers        Int     @default(0)
  avgOrderValue          Float   @default(0)
  currencyCode           String?

  @@unique([shop, affiliateCode, month])
  @@index([shop, month])
  @@index([shop, affiliateCode])
}

model AffiliateSyncMeta {
  shop                 String    @unique
  status               String    @default("idle")
  errorMessage         String?
  phase                String?
  progressCount        Int?
  startedAt            DateTime?
  lastSyncedAt         DateTime?
  lastOrderCursor      String?
  totalOrders          Int?
  totalAffiliateOrders Int?
  updatedAt            DateTime  @updatedAt
}

// Per-shop registration of a Shopify code-discount node as an "affiliate
// program". Coupon codes belonging to the discount auto-sync hourly into
// AffiliateCode. Multiple programs are allowed per shop.
model AffiliateProgram {
  id             String    @id @default(cuid())
  shop           String
  discountNodeId String // gid://shopify/DiscountCodeNode/xxx
  label          String // user-facing program name (unique per shop)
  discountTitle  String // cached at add-time, refreshed on each sync
  status         String    @default("active") // "active" | "removed"
  lastSyncedAt   DateTime?
  lastSyncStatus String? // "ok" | "failed"
  lastSyncError  String?
  codesCount     Int       @default(0)
  mappedCount    Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([shop, discountNodeId])
  @@unique([shop, label])
  @@index([shop, status])
}

// Coupon codes synced from Shopify discount registrations (or imported via
// BixGrow CSV with programId=null). One row per (shop, code).
model AffiliateCode {
  id              String   @id @default(cuid())
  shop            String
  code            String // literal coupon string, uppercased on write
  programId       String? // null after program is removed (soft-delete)
  profileId       String? // null when not yet mapped to an affiliate
  asyncUsageCount Int      @default(0)
  shopifyCodeId   String? // gid://shopify/DiscountRedeemCode/xxx
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())

  @@unique([shop, code])
  @@index([shop, programId])
  @@index([shop, profileId])
}

model GeocodeCacheEntry {
  id        String   @id @default(cuid())
  queryKey  String   @unique
  lat       Float
  lng       Float
  route     String?
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model RoutePolylineCache {
  id              String   @id @default(cuid())
  shop            String
  locationId      String
  orderIdsKey     String // sorted order IDs joined by "|"
  encodedPolyline String
  // Full computeRoutePolyline result so cache hits skip the Google Routes call.
  // Nullable: legacy rows (created before these columns existed) fall through to recompute.
  distanceMeters  Int?
  durationSeconds Int?
  orderedIdsKey   String? // ordered order IDs joined by "|" (Google's optimized stop sequence)
  createdAt       DateTime @default(now())

  @@unique([shop, locationId, orderIdsKey])
  @@index([shop, locationId])
}

model BulkPriceCampaign {
  id             String    @id @default(cuid())
  shop           String
  name           String
  status         String    @default("draft")
  discountType   String    @default("percentage")
  discountValue  Float
  filterType     String    @default("product_types")
  filterValues   String    @default("[]")
  excludeEnabled Boolean   @default(false)
  excludeType    String    @default("tags")
  excludeValues  String    @default("[]")
  startAt        DateTime
  endAt          DateTime?
  activatedAt    DateTime?
  deactivatedAt  DateTime?
  productCount   Int       @default(0)
  variantCount   Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  priceTagsEnabled           Boolean @default(false)
  priceTagMetaobjectType     String?
  priceTagDisplayNameKey     String?
  priceTagFieldDefaults      String?
  priceTagMetafieldNamespace String?
  priceTagMetafieldKey       String?

  items BulkPriceCampaignItem[]

  @@index([shop])
  @@index([shop, status])
}

model BulkPriceCampaignItem {
  id                     String   @id @default(cuid())
  campaignId             String
  shop                   String
  productGid             String
  variantGid             String
  originalPrice          Float
  originalCompareAtPrice Float?
  appliedPrice           Float
  appliedCompareAtPrice  Float
  createdAt              DateTime @default(now())

  campaign BulkPriceCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([shop, variantGid])
}

model RouteOptimizationSnapshot {
  id               String   @id @default(cuid())
  shop             String
  locationId       String
  proposedAt       DateTime @default(now())
  /// Array<{ routeIndex, orderIds, serviceType, costSubunits }>
  proposedRoutes   Json
  /// Array<{ orderId, lat, lng }> for geographic analysis
  orderCoordinates Json
  orderCount       Int
  routeCount       Int

  @@index([shop, locationId, proposedAt])
}

model RouteCorrection {
  id                   String   @id @default(cuid())
  shop                 String
  snapshotId           String
  dispatchedAt         DateTime @default(now())
  dispatchedRouteIndex Int?
  /// Array<{ orderId, fromRoute, toRoute, lat, lng }>
  corrections          Json
  wasModified          Boolean
  ordersReassigned     Int
  ordersDispatched     Int

  @@index([shop, dispatchedAt])
  @@index([snapshotId])
}

model WaitlistSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("gbp-health-check")
  createdAt DateTime @default(now())
  /// Free-form lead metadata (e.g. store_url, pain, workaround, timeline) keyed by source variant
  metadata  Json?
}

// ─── Shopify Ingest Layer: canonical normalized tables ───────────────────────
// Source of truth for Shopify store data. Webhooks write here; features read
// projections from here. A drift-aware hourly cron reconciles dropped webhooks.
// Phase 1 runs in shadow mode — these tables are populated alongside the
// existing feature tables until a 48h diff check confirms equivalence.

model ShopOrder {
  shop                  String
  id                    String // gid://shopify/Order/{n}
  legacyId              String? // numeric legacy id as string (avoid BigInt JSON pitfalls)
  name                  String? // "#1001"
  sourceName            String? // "pos" | "web" | "shopify_draft_order" | null
  status                String? // "open" | "closed" | "cancelled"
  orderDate             DateTime // processed_at || created_at
  createdAt             DateTime
  shopifyUpdatedAt      DateTime // used as watermark for drift detection
  cancelledAt           DateTime?
  closedAt              DateTime?
  customerId            String?
  currencyCode          String?
  currentTotalPrice     Float     @default(0)
  currentTotalDiscounts Float     @default(0)
  currentTotalRefunded  Float     @default(0)
  locationId            String? // POS location (gid) when applicable
  shippingAddressJson   Json?
  billingAddressJson    Json?
  customerJson          Json?
  tagsJson              Json      @default("[]")
  refundsJson           Json?
  lineItemsJson         Json?
  staffMemberId         String?
  staffMemberName       String?
  ingestedAt            DateTime  @default(now())
  ingestedVia           String? // "webhook" | "reconcile" | "backfill"

  @@id([shop, id])
  @@index([shop, shopifyUpdatedAt])
  @@index([shop, orderDate])
  @@index([shop, customerId])
  @@index([shop, locationId])
  @@index([shop, status])
}

model ShopCustomer {
  shop               String
  id                 String // gid://shopify/Customer/{n}
  legacyId           String?
  email              String?
  phone              String?
  displayName        String?
  firstName          String?
  lastName           String?
  createdAt          DateTime?
  shopifyUpdatedAt   DateTime // watermark for drift detection
  ordersCount        Int?
  totalSpent         Float?
  defaultAddressJson Json? // { city, province, country, zip, lat, lng }
  addressesJson      Json?
  tagsJson           Json      @default("[]")
  ingestedAt         DateTime  @default(now())
  ingestedVia        String?

  @@id([shop, id])
  @@index([shop, shopifyUpdatedAt])
  @@index([shop, email])
}

model ShopProduct {
  shop             String
  id               String // gid://shopify/Product/{n}
  legacyId         String?
  title            String
  handle           String?
  productType      String?
  vendor           String?
  status           String? // "ACTIVE" | "DRAFT" | "ARCHIVED"
  createdAt        DateTime?
  shopifyUpdatedAt DateTime
  publishedAt      DateTime?
  tagsJson         Json      @default("[]")
  variantsJson     Json      @default("[]")
  imagesJson       Json?
  metafieldsJson   Json?
  ingestedAt       DateTime  @default(now())
  ingestedVia      String?

  @@id([shop, id])
  @@index([shop, shopifyUpdatedAt])
  @@index([shop, handle])
}

model ShopLocation {
  shop                 String
  id                   String // gid://shopify/Location/{n}
  legacyId             String?
  name                 String
  addressJson          Json?
  isActive             Boolean   @default(true)
  fulfillsOnlineOrders Boolean   @default(false)
  localPickupEnabled   Boolean   @default(false)
  isRetailStore        Boolean   @default(false) // localPickupSettingsV2 != null
  shopifyUpdatedAt     DateTime?
  ingestedAt           DateTime  @default(now())
  ingestedVia          String?

  @@id([shop, id])
}

// Drift-detection watermarks per shop per entity. One row per shop.
model ShopIngestMeta {
  shop                         String    @unique
  ordersLastSeenUpdatedAt      DateTime?
  customersLastSeenUpdatedAt   DateTime?
  productsLastSeenUpdatedAt    DateTime?
  locationsLastRefreshedAt     DateTime?
  ordersLastReconcileAt        DateTime?
  customersLastReconcileAt     DateTime?
  productsLastReconcileAt      DateTime?
  ordersBackfillCompletedAt    DateTime?
  customersBackfillCompletedAt DateTime?
  productsBackfillCompletedAt  DateTime?
  ordersRowCount               Int?
  customersRowCount            Int?
  productsRowCount             Int?
  status                       String    @default("idle") // idle | syncing | error
  errorMessage                 String?
  updatedAt                    DateTime  @updatedAt
}

// ─── Attribution Queue (IGLU/WhatsApp orders missing from BixGrow) ──────────

model AttributionClaim {
  id             String    @id @default(cuid())
  shop           String
  orderName      String
  orderGid       String?
  couponCode     String
  affiliateCode  String?
  affiliateEmail String?
  subtotal       Float?
  currencyCode   String?
  sourceName     String?
  orderDate      DateTime?
  claimedBy      String?
  claimedAt      DateTime  @default(now())
  confirmedAt    DateTime?
  confirmedVia   String?

  @@unique([shop, orderName])
  @@index([shop, confirmedAt])
  @@index([shop, claimedAt])
}

model PedidosImport {
  id              String    @id @default(cuid())
  shop            String
  importedAt      DateTime  @default(now())
  importedBy      String?
  rowCount        Int       @default(0)
  maxOrderDate    DateTime?
  claimsConfirmed Int       @default(0)
  fileName        String?

  @@index([shop, importedAt])
}

model BixgrowAttributedOrder {
  id        String    @id @default(cuid())
  shop      String
  orderName String
  orderDate DateTime?
  importId  String
  createdAt DateTime  @default(now())

  @@unique([shop, orderName])
  @@index([shop, importId])
}

// Flagged by the orders webhook: IGLU POS / WhatsApp Hexagon orders that
// carry a UGC coupon code and therefore might need affiliate attribution.
// Populated in real-time so the Attribution tab can render candidates
// without waiting for an hourly live-Shopify pagination.
model AttributionCandidate {
  shop          String
  orderGid      String
  orderName     String?
  sourceName    String? // "206755758081" (IGLU) | "316281618433" (WhatsApp Hexagon)
  primaryCoupon String? // lowercased coupon code from order_discounts_info custom attr
  orderDate     DateTime?
  discoveredAt  DateTime  @default(now())
  discoveredVia String? // "webhook" | "cron"

  @@id([shop, orderGid])
  @@index([shop, orderDate])
  @@index([shop, primaryCoupon])
}

// Hourly snapshot of the Attribution queue so the Attribution tab loader can
// paint instantly without paginating Shopify on every page load. The Refresh
// button still calls buildAttributionQueueSnapshot(force) and overwrites this
// row.
model AttributionQueueSnapshot {
  shop         String   @id
  fetchedAt    DateTime @default(now())
  fetchedVia   String? // "cron" | "manual"
  lookbackDays Int      @default(90)
  scannedCount Int      @default(0)
  pendingCount Int      @default(0)
  claimedCount Int      @default(0)
  unknownCount Int      @default(0)
  rowsJson     Json     @default("[]")
  statsJson    Json     @default("{}")
  updatedAt    DateTime @updatedAt
}

// =====================================================================
// Local Delivery Analytics (v1)
// See docs/plans/local-delivery-analytics.md §3.
// All four tables are additive; no existing read paths reference them.
// =====================================================================

model WarehouseCarrierCredential {
  id                  String    @id @default(cuid())
  shop                String
  provider            String // "intelipost" | future: "frenet" | "melhor_envio"
  apiKeyCiphertext    String
  apiSecretCiphertext String? // null for providers that use single-key auth
  apiEndpoint         String? // optional override (sandbox vs prod)
  keyVersion          Int       @default(1)
  lastValidatedAt     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([shop, provider])
  @@index([shop])
}

model WarehouseCarrierQuoteCache {
  id              String   @id @default(cuid())
  shop            String
  orderId         String // gid://shopify/Order/{n}
  provider        String
  priceSubunits   Int // currency minor units (cents)
  currency        String
  minDeliveryDate String?
  maxDeliveryDate String?
  rawResponseJson Json?
  quotedAt        DateTime @default(now())
  expiresAt       DateTime

  @@unique([shop, orderId, provider])
  @@index([shop, expiresAt])
  @@index([shop, orderId])
}

model LdAnalyticsDaily {
  id                              String   @id @default(cuid())
  shop                            String
  cityNorm                        String
  cityDisplay                     String
  date                            DateTime // truncated to UTC midnight
  ldOrderCount                    Int      @default(0)
  ldRevenueSubunits               Int      @default(0) // customer-charged for LD
  ldCarrierCostSubunits           Int      @default(0) // Lalamove quote total
  warehouseCounterfactualSubunits Int      @default(0) // sum of WH carrier-rate quotes
  warehouseCustomerRateSubunits   Int      @default(0) // sum of customer-charged WH counterfactuals
  taxSavingsSubunits              Int      @default(0)
  currencyCode                    String
  coveragePercent                 Int // 0-100, % of orders successfully quoted
  computedAt                      DateTime @default(now())

  @@unique([shop, cityNorm, date])
  @@index([shop, date])
}

model LdAnalyticsConfig {
  shop                         String   @id
  enabled                      Boolean  @default(false)
  headlineFraming              String   @default("net_cost_delta") // pl_impact | revenue_retained | net_cost_delta. v1 default is net_cost_delta because pl_impact requires LD revenue capture (ShopOrder.shippingLines) which is deferred to v2.
  perCityTaxSavingsJson        Json     @default("{}")
  perLocationWarehouseCostJson Json     @default("{}")
  partialDataThresholdPercent  Int      @default(80)
  quoteCacheTtlDays            Int      @default(90)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}
