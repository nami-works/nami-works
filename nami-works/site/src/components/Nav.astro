---

// Single-page matchmaking funnel (2026-09-30 pivot): "one screen, one
// promise, one button" -- no nav links, since there is nowhere else to go.
---

<nav class="nav" id="site-nav">
  <a href="/" class="navLogo" aria-label="nami.works">
    <picture>
      <source srcset="/brand/lockup-cream.png" media="(prefers-color-scheme: dark)" />
      <img src="/brand/lockup-ink.png" alt="" class="navLockup" height="28" />
    </picture>
  </a>
</nav>

<script>
  const nav = document.getElementById("site-nav");
  const onScroll = () => {
    if (!nav) return;
    nav.classList.toggle("navScrolled", window.scrollY > 10);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px;
    z-index: 100;
    border-bottom: 1px solid transparent;
    transition: background-color 0.3s ease, backdrop-filter 0.3s ease, border-color 0.3s ease;
  }

  .navScrolled {
    background-color: var(--site-nav-bg);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom-color: var(--site-border);
  }

  .navLogo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  /* Primary lockup (glyph + nami.works), brand-spec.md §2 -- "site header"
     row. Two pre-composed images (icon+wordmark baked in), picked by the
     visitor's system colour scheme.
     Sized up slightly from the old multi-link nav (30px vs 28px): alone in
     an otherwise-empty bar, the mark is the only thing establishing trust,
     so it carries a touch more presence. */
  .navLockup {
    height: 30px;
    width: auto;
    max-width: none;
  }

</style>
