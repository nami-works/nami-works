  }

  .field {
    display: grid;
    gap: 8px;
    margin-bottom: 16px;
  }

  .field[hidden] {
    display: none;
  }

  /* --site-erro is reserved for strike-throughs per the design tokens, so a
     failed submit reads as plain emphasised text. */
  .aiPromptLabel {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .aiPromptText {
    width: 100%;
    box-sizing: border-box;
