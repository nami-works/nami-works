---
// Shared below-fold experience for the nami.works matchmaking funnel:
// quiz -> diagnostic -> tiers -> confirmation. Used by the generic home
// page and by every persona landing page (same mechanism, only the
// above-fold hero differs -- see src/pages/para/[persona].astro).
//
// Copy verbatim from nami-works/matchmaking/funnel-spec.md. Stage lines
// validated 2026-10-01 (4 independent review passes, see the matchmaking
// initiative file).

interface Props {
  // Set by a persona landing page to skip asking "onde você sente que
  // travou" -- the persona already answers it. Must be a key of PAIN_BLOCKS.
  prefilledDor?: string;
  // Recorded on the submission for attribution back to the landing page.
  persona?: string;
}

const { prefilledDor, persona } = Astro.props;

const fases = [
  "ainda é uma ideia",
  "começo promissor",
  "já roda, quero escalar",
  "crescendo, pede estrutura",
];

const dores = [
  "mercado e clientes",
  "vendas e marketing",
  "caixa e finanças",
  "priorização e execução",
  "time e gestão",
  "produto",
  "escalar o negócio",
  "não sei por onde começar",
];

const caminhos = [
  "implementar com IA",
  "agência ou freelancer",
  "contratar equipe",
  "fornecedor/parceiro",
  "consultoria",
];

const resultadosCaminho = [
  "não resolveu",
  "resolveu em parte",
  "funcionou, mas não se sustentou",
];

// Asked once per tried path, right after its outcome question: whether the
// time and money put into that path felt worth it (it used to be one of the
// per-path outcomes).
const retornos = [
  "valeu o investimento",
  "valeu em parte",
  "custou mais do que valia",
];

// Talking to peers is free and happens independently of the paths above, so
// it is its own question rather than one more path.
const paresOpcoes = [
  "sim, e ajudou",
  "sim, e ajudou em parte",
  "sim, mas não ajudou",
  "ainda não",
];

// Each maps to a tier: caminho prático -> Expert, aprender com quem já viveu
// -> Colega (peer), apoio e acompanhamento -> Sênior (advisor).
const valores = [
  "traçar um caminho prático",
  "aprender com quem já viveu",
  "conexão para trocas",
  "projeto de consultoria",
  "apoio e acompanhamento",
];

const VALOR_OUTRA = "outra";

const TIERS = [
  { nome: "Colega", quem: "alguém que já viveu algo parecido", duracaoPreco: "45 min · R$200", leva: "bate-papo e troca de experiência" },
  { nome: "Sênior", quem: "profissional com 10+ anos na área", duracaoPreco: "45 min · R$350", leva: "conversa com direção prática" },
  { nome: "Expert", quem: "especialista de referência no seu tema", duracaoPreco: "45 min · R$500", leva: "conversa com plano de próximos passos" },
];
---

<section class="section sectionSoft" id="quiz" hidden data-prefilled-dor={prefilledDor ?? ""} data-persona={persona ?? ""}>
  <div class="container narrow">
    <form class="quizForm" id="quizForm">
      <div class="progressShell" hidden>
        <p class="progressLabel">Pergunta 1</p>
        <div class="progressTrack"><div class="progressFill"></div></div>
      </div>

      <fieldset class="step" data-step="fase">
        <legend class="stepLegend">em que fase está o negócio?</legend>
        <div class="chips" role="radiogroup" aria-label="em que fase está o negócio?">
          {fases.map((f) => (
            <label class="chip">
              <input type="radio" name="fase" value={f} required />
              <span>{f}</span>
            </label>
          ))}
        </div>
        <div class="navRow" hidden>
          <button type="button" class="ctaSecondary btnBack" hidden>voltar</button>
          <button type="button" class="ctaPrimary btnNext">continuar</button>
        </div>
      </fieldset>

      <fieldset class="step" data-step="dor" hidden>
        <legend class="stepLegend">onde você sente que travou? <span class="optional">(escolha até duas)</span></legend>
        <div class="chips" role="group" aria-label="onde você sente que travou?" id="doresGroup">
          {dores.map((d) => (
            <label class="chip" data-fase-only={d === "não sei por onde começar" ? "ainda é uma ideia" : undefined}>
              <input type="checkbox" name="dor" value={d} />
              <span>{d}</span>
            </label>
          ))}
        </div>
        <div class="navRow" hidden>
          <button type="button" class="ctaSecondary btnBack">voltar</button>
          <button type="button" class="ctaPrimary btnNext">continuar</button>
        </div>
      </fieldset>

      <fieldset class="step" data-step="caminhos" hidden>
        <legend class="stepLegend">já tentou algum destes caminhos? <span class="optional">(pode marcar vários)</span></legend>
        <div class="chips" role="group" aria-label="já tentou algum destes caminhos?" id="caminhosGroup">
          {caminhos.map((c) => (
            <label class="chip">
              <input type="checkbox" name="caminhos" value={c} />
              <span>{c}</span>
            </label>
          ))}
        </div>
        <div class="navRow" hidden>
          <button type="button" class="ctaSecondary btnBack">voltar</button>
          <button type="button" class="ctaSecondary btnSkip">ainda não tentei</button>
          <button type="button" class="ctaPrimary btnNext">continuar</button>
        </div>
      </fieldset>

      {[0, 1].map((slot) => (
        <fieldset class="step followupStep" data-step={`seguimento${slot}`} data-slot={slot} hidden>
          <legend class="stepLegend followupLegend">como foi <span class="followupPath"></span>?</legend>
          <div class="chips" role="radiogroup">
            {resultadosCaminho.map((r) => (
              <label class="chip">
                <input type="radio" name={`seguimento${slot}`} value={r} required />
                <span>{r}</span>
              </label>
            ))}
          </div>
          <div class="navRow" hidden>
            <button type="button" class="ctaSecondary btnBack">voltar</button>
            <button type="button" class="ctaPrimary btnNext">continuar</button>
          </div>
        </fieldset>
      ))}

      {[0, 1].map((slot) => (
        <fieldset class="step retornoStep" data-step={`retorno${slot}`} data-slot={slot} hidden>
          <legend class="stepLegend">pensando no que você investiu nesse caminho (tempo e dinheiro), valeu a pena?</legend>
          <div class="chips" role="radiogroup" aria-label="pensando no que você investiu nesse caminho (tempo e dinheiro), valeu a pena?">
            {retornos.map((r) => (
              <label class="chip">
                <input type="radio" name={`retorno${slot}`} value={r} required />
                <span>{r}</span>
              </label>
            ))}
          </div>
          <div class="navRow" hidden>
            <button type="button" class="ctaSecondary btnBack">voltar</button>
            <button type="button" class="ctaPrimary btnNext">continuar</button>
          </div>
        </fieldset>
      ))}

      <fieldset class="step" data-step="pares" hidden>
        <legend class="stepLegend">já conversou com outros empreendedores sobre isso?</legend>
        <div class="chips" role="radiogroup" aria-label="já conversou com outros empreendedores sobre isso?">
          {paresOpcoes.map((r) => (
            <label class="chip">
              <input type="radio" name="pares" value={r} required />
              <span>{r}</span>
            </label>
          ))}
        </div>
        <div class="navRow" hidden>
          <button type="button" class="ctaSecondary btnBack">voltar</button>
          <button type="button" class="ctaPrimary btnNext">continuar</button>
        </div>
      </fieldset>

      <fieldset class="step" data-step="valor" hidden>
        <legend class="stepLegend">o que ajudaria mais agora?</legend>
        <div class="chips" role="radiogroup" aria-label="o que ajudaria mais agora?">
          {valores.map((v) => (
            <label class="chip">
              <input type="radio" name="valor" value={v} required />
              <span>{v}</span>
            </label>
          ))}
          <label class="chip">
            <input type="radio" name="valor" value={VALOR_OUTRA} required />
            <span>outra coisa...</span>
          </label>
        </div>
        <div class="field valorOutroField" hidden>
          <label for="valorOutro">qual?</label>
          <input type="text" id="valorOutro" name="valorOutro" placeholder="me conta rapidinho" />
        </div>
        <div class="navRow" hidden>
          <button type="button" class="ctaSecondary btnBack">voltar</button>
          <button type="button" class="ctaPrimary btnNext" id="btnVerDiagnostico">concluir</button>
        </div>
      </fieldset>
    </form>
  </div>
</section>

<section class="section" id="diagnostico" hidden>
  <div class="container narrow">
    <div id="diagnosticoEmRede">
      <p class="eyebrow">sua principal trava</p>
      <h2 class="sectionTitle display display-3" id="diagTitulo"></h2>
      <p class="diagSecundaria" id="diagSecundaria" hidden></p>

      <p class="diagLabel">o que isso costuma significar</p>
      <p class="diagTexto" id="diagSignificado"></p>

      <p class="diagLabel">o que dá pra fazer hoje</p>
      <ol class="diagPassos">
        <li class="diagTexto" id="diagPasso"></li>
        <li class="diagTexto">conversar com alguém que pode ajudar</li>
      </ol>

      <div class="ctaRow">
        <button type="button" class="ctaPrimary" id="btnVerTiers">ver quem pode conversar comigo</button>
      </div>
    </div>

    <div id="diagnosticoForaDeRede" hidden>
      <h2 class="sectionTitle display display-3">vamos te conectar com um profissional em breve.</h2>
      <p class="lede">
        nosso algoritmo vai encontrar a pessoa certa pra esse tema e te chamar assim que ela chegar.
      </p>
      <div class="ctaRow">
        <button type="button" class="ctaPrimary" id="btnMeAvise">me avise</button>
      </div>
    </div>
  </div>
</section>

<section class="section sectionSoft" id="waitlist" hidden>
  <div class="container narrow">
    <form id="waitlistForm">
      <p class="eyebrow">me avise</p>
      <h2 class="sectionTitle display display-3">deixa seu contato <span class="mk">que a gente te chama</span>.</h2>
      <div class="field">
        <label for="waitlistEmail">e-mail</label>
        <input type="email" id="waitlistEmail" name="email" required placeholder="voce@empresa.com" />
      </div>
      <div class="field">
        <label for="waitlistTelefone">telefone</label>
        <input type="tel" id="waitlistTelefone" name="telefone" required placeholder="(11) 90000-0000" />
      </div>
      <p class="formError" id="waitlistError" role="alert" hidden></p>
      <div class="ctaRow">
        <button type="submit" class="ctaPrimary">confirmar</button>
      </div>
    </form>
  </div>
</section>

<section class="section" id="tiers" hidden>
  <div class="container">
    <p class="eyebrow">como conversar</p>
    <h2 class="sectionTitle display display-3">três jeitos de conversar, <span class="mk">a mesma troca de 45 minutos</span>.</h2>

    <p class="tierMotivo" id="tierMotivo" hidden></p>

    <div class="tiersGrid" id="tiersGrid" role="radiogroup" aria-label="escolha um plano">
      {TIERS.map((t) => (
        <button type="button" class="tierCard" data-tier={t.nome}>
          <span class="tierRecomendado" hidden>recomendado pra você</span>
          <p class="tierNome">{t.nome}</p>
          <p class="tierQuem">{t.quem}</p>
          <p class="tierDuracaoPreco">{t.duracaoPreco}</p>
          <p class="tierLeva">{t.leva}</p>
        </button>
      ))}
    </div>

    <p class="tierMencao" id="tierMencao" hidden></p>
    <p class="tierAviso"><b>nada é cobrado agora.</b> você só paga depois de aceitar a conexão com o profissional.</p>

    <div class="ctaRow">
      <button type="button" class="ctaPrimary" id="btnVerConfirmacao" disabled>continuar</button>
    </div>
  </div>
</section>

<section class="section sectionSoft" id="confirmacao" hidden>
  <div class="container narrow">
    <form id="confirmacaoForm">
      <p class="eyebrow">sua conversa</p>
      <h2 class="sectionTitle display display-3" id="confirmacaoResumo"></h2>

      <div class="field">
        <label for="confNome">seu nome</label>
        <input type="text" id="confNome" name="nome" required placeholder="nome e sobrenome" />
      </div>
      <div class="field">
        <label for="confTelefone">telefone</label>
        <input type="tel" id="confTelefone" name="telefone" required placeholder="(11) 90000-0000" />
      </div>
      <div class="field">
        <label for="confEmail">e-mail</label>
        <input type="email" id="confEmail" name="email" required placeholder="voce@empresa.com" />
      </div>

      <p class="formError" id="confirmacaoError" role="alert" hidden></p>
      <div class="ctaRow">
        <button type="submit" class="ctaPrimary">confirmar minha conversa</button>
      </div>
      <p class="confirmacaoAviso">
        você recebe um e-mail confirmando sua conversa. a gente te chama assim que encontrar a pessoa certa pra esse papo. nada é cobrado antes de você aceitar a conexão.
      </p>
    </form>
  </div>
</section>

<section class="section" id="obrigado" hidden>
  <div class="container narrow">
    <p class="eyebrow">prontinho</p>
    <h2 class="sectionTitle display display-3" id="obrigadoTitulo">recebemos.</h2>
    <p class="lede" id="obrigadoTexto"></p>
  </div>
</section>

<section class="section sectionSoft" id="aiPrompt" hidden>
  <div class="container narrow">
    <p class="eyebrow">enquanto isso</p>
    <h2 class="sectionTitle display display-3">organize seus próximos passos <span class="mk">com a sua IA</span>.</h2>
    <p class="lede">copie o texto abaixo e cole no ChatGPT, no Claude ou na IA que você já usa. ele já vem com as suas respostas.</p>
    <label class="aiPromptLabel" for="aiPromptText">texto para a sua IA</label>
    <textarea id="aiPromptText" class="aiPromptText" readonly rows="9"></textarea>
    <div class="ctaRow aiPromptActions">
      <button type="button" class="ctaPrimary" id="btnCopiarPrompt">copiar texto</button>
      <span class="aiPromptCopied" id="aiPromptCopied" role="status"></span>
    </div>
    <details class="aiPromptHelp">
      <summary>como usar</summary>
      <ol id="aiPromptSteps"></ol>
    </details>
    <p class="aiPromptNote" id="aiPromptNote"></p>
  </div>
</section>

<script>
  type Answers = {
    fase: string | null;
    dores: string[]; // in click order, at most 2; the first is the main one
    caminhos: string[]; // in click order
    seguimentos: Record<string, string>; // path -> outcome
    retornos: Record<string, string>; // path -> whether the time and money spent felt worth it
    pares: string | null; // outcome of talking to other entrepreneurs
    valor: string | null;
  };

  // Namespaced per persona (falls back to "generic" on the main page) --
  // sessionStorage is shared across the whole origin, so without this a
  // visitor who starts the quiz on one persona page and later opens a
  // different one would silently resume a different pain's answers.
  let STORAGE_KEY = "nami-quiz-state-v3:generic";

  function emptyAnswers(): Answers {
    return { fase: null, dores: [], caminhos: [], seguimentos: {}, retornos: {}, pares: null, valor: null };
  }

  function loadAnswers(): Answers {
    try {
      const raw = sessionStorage.getItem(STORAGE_KEY);
      if (!raw) return emptyAnswers();
      const parsed = JSON.parse(raw);
      return { ...emptyAnswers(), ...parsed };
    } catch {
      return emptyAnswers();
    }
  }

  function saveAnswers(a: Answers) {
    try {
      sessionStorage.setItem(STORAGE_KEY, JSON.stringify(a));
    } catch {
      /* private mode / storage disabled, no-op */
    }
  }

  // ---- Diagnostic engine (Phase 3): deterministic v1, swappable later ----
  // passoPorFase (optional) overrides primeiroPasso for a given fase; the
  // plain primeiroPasso is the fallback when a stage has no specific step.
  const PAIN_BLOCKS: Record<
    string,
    { significado: string; primeiroPasso: string; passoPorFase?: Record<string, string>; inNetwork: boolean }
  > = {
    "mercado e clientes": {
      significado: "o produto existe, mas o cliente não chega ou não fecha. quase sempre falta clareza sobre quem compra e por quê.",
      primeiroPasso: "liste seus 3 últimos clientes e o que fez cada um comprar de você. depois, busque perfis parecidos e ajuste o discurso de acordo com o valor que você já gerou a quem comprou.",
      passoPorFase: {
        "ainda é uma ideia":
          "defina quem é o seu primeiro cliente: descreva uma pessoa real que tem esse problema, onde ela está e como você chegaria até ela. depois converse com 5 pessoas com esse perfil.",
        "começo promissor":
          "liste seus 3 últimos clientes e o que fez cada um comprar de você. depois, busque perfis parecidos e ajuste o discurso de acordo com o valor que você já gerou a quem comprou.",
        "já roda, quero escalar":
          "separe seus clientes entre quem compra mais vezes e quem compra mais caro. descreva o que eles têm em comum e procure mais perfis como esses, nos mesmos lugares onde encontrou os primeiros.",
        "crescendo, pede estrutura":
          "registre o caminho que o cliente percorre até comprar (de onde vem, quem atende, o que decide) e identifique o ponto em que mais pessoas desistem. defina um responsável por melhorar esse ponto.",
      },
      inNetwork: true,
    },
    "caixa e finanças": {
      significado: "o caixa aperta e fica difícil decidir. muitas vezes o problema é não enxergar pra onde o dinheiro vai.",
      primeiroPasso: "registre todas as entradas e saídas dos últimos 30 dias numa planilha simples. identifique os 3 maiores gastos e avalie onde é possível reduzir ou renegociar.",
      passoPorFase: {
        "ainda é uma ideia":
          "some o que você precisa gastar até o primeiro cliente pagante e por quantos meses o seu dinheiro cobre isso. separe desde já o gasto do negócio do gasto pessoal.",
        "começo promissor":
          "registre todas as entradas e saídas dos últimos 30 dias numa planilha simples. identifique os 3 maiores gastos e avalie onde é possível reduzir ou renegociar.",
        "já roda, quero escalar":
          "calcule quanto sobra em cada venda depois de descontar o custo do que você entrega. antes de investir para crescer, confirme que cada venda a mais deixa dinheiro no caixa e projete as próximas 12 semanas de entradas e saídas.",
        "crescendo, pede estrutura":
          "projete o que você espera receber e pagar nos próximos 3 meses e defina quem atualiza toda semana. mantenha uma reserva para os meses mais fracos e estabeleça quais gastos precisam de aprovação.",
      },
      inNetwork: true,
    },
    "priorização e execução": {
      significado: "tem muita coisa pra fazer e pouca saindo do papel. sem uma ordem clara, tudo parece urgente e nada avança.",
      primeiroPasso: "duas vezes ao dia, resolva de uma vez tudo o que leva menos de 2 minutos. do que sobrar, liste o que está em andamento e escolha as 3 que mais movem o negócio. comece por elas e repita o processo toda semana.",
      passoPorFase: {
        "ainda é uma ideia":
          "escolha uma única coisa que prova se a ideia funciona e dedique as próximas 2 semanas só a ela. o que não contribuir para isso fica para depois.",
        "começo promissor":
          "duas vezes ao dia, resolva de uma vez tudo o que leva menos de 2 minutos. do que sobrar, liste o que está em andamento e escolha as 3 que mais movem o negócio. comece por elas e repita o processo toda semana.",
        "já roda, quero escalar":
          "escolha 3 metas para o mês e reserve uma hora por semana para verificar se o que você está fazendo contribui para alguma delas. o que não contribui, delegue ou interrompa.",
        "crescendo, pede estrutura":
          "toda segunda, faça um alinhamento de 15 minutos: cada pessoa lista 3 prioridades para a semana e vocês alinham os detalhes.",
      },
      inNetwork: true,
    },
    "time e gestão": {
      significado: "contratar, delegar ou liderar virou gargalo. o negócio depende demais de você.",
      primeiroPasso: "escreva as 5 tarefas que só você faz e escolha uma pra passar adiante, com o resultado esperado por escrito.",
      passoPorFase: {
        "ainda é uma ideia":
          "execute cada tarefa antes de delegar: para treinar alguém, você precisa saber fazer. mantenha o time pequeno até alguém pagar bem pelo que você oferece.",
        "começo promissor":
          "delegue o que não for estratégico, para liberar tempo para pensar: escreva o passo a passo, depois passe adiante, alinhando com clareza o resultado esperado.",
        "já roda, quero escalar":
          "identifique as áreas em que outra pessoa pode render mais do que você e traga essa pessoa para o time. antes de contratar, converse mais de uma vez e peça referências a quem já trabalhou com ela.",
        "crescendo, pede estrutura":
          "defina 3 metas claras para o trimestre e quem responde por cada uma. combine o que cada pessoa decide sozinha e o que ainda passa por você.",
      },
      inNetwork: true,
    },
    produto: {
      significado: "você tem a ideia, mas não sabe se é isso que o mercado quer.",
      primeiroPasso: "antes de investir mais tempo ou dinheiro, converse com 3 clientes satisfeitos e 3 possíveis clientes. entenda o que mais pesa no dia a dia deles, por que compram de você (ou comprariam) e o que ajudaria mais.",
      passoPorFase: {
        "ainda é uma ideia":
          "antes de construir, converse com 5 possíveis clientes sobre o problema, sem apresentar a solução. descubra se já tentaram resolver, quanto isso custa para eles e se pagariam por algo melhor.",
        "começo promissor":
          "antes de investir mais tempo ou dinheiro, converse com 3 clientes satisfeitos e 3 possíveis clientes. entenda o que mais pesa no dia a dia deles, por que compram de você (ou comprariam) e o que ajudaria mais.",
        "já roda, quero escalar":
          "pergunte aos clientes que mais compram o que eles fariam se o produto deixasse de existir e o que ainda falta. use as respostas para decidir o que melhorar antes de vender para mais gente.",
        "crescendo, pede estrutura":
          "levante os pedidos e reclamações mais repetidos dos últimos 3 meses e escolha um para resolver primeiro. defina quem cuida da evolução do produto e como o time traz o que ouve dos clientes.",
      },
      inNetwork: true,
    },
    "vendas e marketing": {
      significado: "você aparece, mas não vê resultado. normalmente falta foco em um canal e uma mensagem.",
      primeiroPasso: "escolha um único canal de divulgação (Instagram, WhatsApp, indicação) e uma mensagem para testar por 2 semanas. registre quantas pessoas viram, quantas responderam e quantas compraram. depois decida: manter, ajustar ou trocar.",
      passoPorFase: {
        "ainda é uma ideia":
          "antes de gastar com divulgação, escreva em uma frase quem você ajuda e qual problema resolve. mostre a 5 pessoas desse perfil e verifique se entendem sem precisar de explicação.",
        "começo promissor":
          "escolha um único canal de divulgação (Instagram, WhatsApp, indicação) e uma mensagem para testar por 2 semanas. registre quantas pessoas viram, quantas responderam e quantas compraram. depois decida: manter, ajustar ou trocar.",
        "já roda, quero escalar":
          "identifique de qual canal vêm os clientes que mais compram e concentre mais esforço nele. teste uma mensagem nova por vez, por 2 semanas, e compare com a atual.",
        "crescendo, pede estrutura":
          "defina uma meta de vendas por canal e quem responde por cada um. toda semana, acompanhe os mesmos números (contatos, propostas, vendas) para decidir onde ajustar.",
      },
      inNetwork: true,
    },
    "não sei por onde começar": {
      significado: "frentes demais abertas paralisam. o primeiro ganho é escolher uma.",
      primeiroPasso: "imagine seu negócio dando certo daqui a 3 anos: o que ele faz e para quem. depois avalie o que isso tem a ver com o que te move e onde há muitas pessoas com esse problema. comece por aí.",
      inNetwork: true,
    },
    "escalar o negócio": {
      significado: "o negócio funciona e você quer crescer, mas crescer rápido demais costuma quebrar o que funciona hoje. o ganho está em saber o que repetir, onde e em que ritmo.",
      primeiroPasso: "escolha uma região ou um tipo de cliente e repita a venda ali até os números ficarem estáveis, antes de ampliar.",
      passoPorFase: {
        "ainda é uma ideia":
          "antes de pensar em escala, faça um teste pequeno: venda para poucas pessoas da mesma região e acompanhe 3 números: quantos compram, quantos voltam e quanto sobra no final.",
        "começo promissor":
          "escolha uma região ou um tipo de cliente e repita a venda ali até os números ficarem estáveis. só depois de repetir com previsibilidade vale ampliar.",
        "já roda, quero escalar":
          "descubra quais clientes compram com mais frequência e concentre o esforço onde eles estão. cresça uma região de cada vez, ganhando ritmo em cada uma antes de abrir a próxima.",
        "crescendo, pede estrutura":
          "o que trouxe você até aqui não escala sozinho. liste as decisões que hoje dependem só de você e escolha 2 para transferir a outra pessoa, para que o crescimento deixe de depender da sua agenda.",
      },
      inNetwork: true,
    },
  };

  // Validated 2026-10-01 -- see the matchmaking initiative file for the
  // 4-reviewer pass that picked these over the alternatives.
  const STAGE_LINES: Record<string, string> = {
    "ainda é uma ideia": "nessa fase, validar vale mais que construir.",
    "começo promissor": "ser promissor não substitui processo por trás.",
    "já roda, quero escalar": "pra crescer, o que funciona hoje precisa rodar sem você em cima o tempo todo.",
    "crescendo, pede estrutura": "nessa fase, o que trava é o resto da empresa não acompanhar o ritmo do negócio.",
  };

  type Diagnostico =
    | { inNetwork: true; significado: string; primeiroPasso: string }
    | { inNetwork: false };

  function computeDiagnostico(dor: string, fase: string): Diagnostico {
    const pain = PAIN_BLOCKS[dor];
    if (!pain || !pain.inNetwork) return { inNetwork: false };
    const stageLine = STAGE_LINES[fase] ?? "";
    return {
      inNetwork: true,
      significado: `${pain.significado} ${stageLine}`.trim(),
      primeiroPasso: pain.passoPorFase?.[fase] ?? pain.primeiroPasso,
    };
  }

  // ---- Tier recommendation (Phase 4) ----
  // Pro/Básico (old names in the spec's signal table) map to Expert/Colega
  // (current card names) -- resolved 2026-10-01, see the initiative file.
  //
  // How talking to other entrepreneurs went (answers.pares) steers this too:
  // Colega is the same format (a peer conversation), so
  //  - it did not help      -> never recommend Colega; lean to a professional;
  //  - it helped            -> Colega is the natural step up (someone who
  //                            solved exactly this), framed in renderTiers;
  //  - it helped in part    -> lean to Sênior to cover what was missing;
  //  - not tried yet        -> Colega is a natural first conversation.
  function recommendTiers(answers: Answers): string[] {
    const matches: string[] = [];
    const naoAjudou = answers.pares === "sim, mas não ajudou";
    const parcial = answers.pares === "sim, e ajudou em parte";
    const ajudou = answers.pares === "sim, e ajudou";
    const aindaNao = answers.pares === "ainda não";

    if (answers.valor === "traçar um caminho prático" || answers.caminhos.includes("consultoria")) {
      matches.push("Expert");
    }
    if (answers.valor === "apoio e acompanhamento" || parcial || naoAjudou) {
      matches.push("Sênior");
    }
    if (
      !naoAjudou &&
      (answers.valor === "aprender com quem já viveu" || answers.caminhos.length === 0 || ajudou || aindaNao)
    ) {
      matches.push("Colega");
    }
    return matches.length ? matches : ["Colega"];
  }

  // ---- UTM / persona continuity (Instagram traffic, 2026-10-01) ----
  function readUtmContext(form: HTMLElement) {
    const params = new URLSearchParams(location.search);
    return {
      persona: form.dataset.persona || undefined,
      utmSource: params.get("utm_source") || undefined,
      utmMedium: params.get("utm_medium") || undefined,
      utmCampaign: params.get("utm_campaign") || undefined,
      utmContent: params.get("utm_content") || undefined,
    };
  }

  // Baked in at build time by scripts/deploy-nami-site.ps1 (the Lambda
  // Function URL from terraform output matchmaking_api_url).
  const API_BASE = ((import.meta.env.PUBLIC_MATCHMAKING_API_BASE as string | undefined) ?? "").replace(/\/+$/, "");

  const SUBMIT_ERROR = "não conseguimos enviar agora. confere sua conexão e tenta de novo.";

  async function createSubmission(body: Record<string, unknown>): Promise<string | null> {
    try {
      const res = await fetch(`${API_BASE}/submissions`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      if (!res.ok) return null;
      const data = await res.json();
      return data.id ?? null;
    } catch {
      return null;
    }
  }

  // 409 = this submission was already finalized (e.g. a double-click or a
  // retry after a response was lost) -- the lead is stored, so it counts.
  async function patchSubmission(id: string, body: Record<string, unknown>): Promise<boolean> {
    try {
      const res = await fetch(`${API_BASE}/submissions/${id}`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      return res.ok || res.status === 409;
    } catch {
      return false;
    }
  }

  (function () {
    const quizSectionMaybe = document.getElementById("quiz");
    const btnStart = document.getElementById("btnStart");
    const formMaybe = document.getElementById("quizForm") as HTMLFormElement | null;
    if (!quizSectionMaybe || !btnStart || !formMaybe) return;
    // Rebind as non-null: TS narrowing from the guard above doesn't carry
    // into the nested functions below that close over these.
    const quizSection = quizSectionMaybe;
    const form = formMaybe;

    const prefilledDor = quizSection.dataset.prefilledDor || null;
    const utmContext = readUtmContext(quizSection);
    STORAGE_KEY = `nami-quiz-state-v3:${quizSection.dataset.persona || "generic"}`;

    const answers = loadAnswers();
    if (prefilledDor) answers.dores = [prefilledDor];

    const stepFase = form.querySelector<HTMLFieldSetElement>('[data-step="fase"]')!;
    const stepDor = form.querySelector<HTMLFieldSetElement>('[data-step="dor"]')!;
    const stepCaminhos = form.querySelector<HTMLFieldSetElement>('[data-step="caminhos"]')!;
    const stepSeguimento0 = form.querySelector<HTMLFieldSetElement>('[data-step="seguimento0"]')!;
    const stepSeguimento1 = form.querySelector<HTMLFieldSetElement>('[data-step="seguimento1"]')!;
    const stepRetorno0 = form.querySelector<HTMLFieldSetElement>('[data-step="retorno0"]')!;
    const stepRetorno1 = form.querySelector<HTMLFieldSetElement>('[data-step="retorno1"]')!;
    const stepPares = form.querySelector<HTMLFieldSetElement>('[data-step="pares"]')!;
    const stepValor = form.querySelector<HTMLFieldSetElement>('[data-step="valor"]')!;
    const progressShell = form.querySelector<HTMLElement>(".progressShell")!;
    const progressFill = form.querySelector<HTMLElement>(".progressFill")!;
    const progressLabel = form.querySelector<HTMLElement>(".progressLabel")!;

    const FOLLOWUP_STEPS = [stepSeguimento0, stepSeguimento1];
    const RETORNO_STEPS = [stepRetorno0, stepRetorno1];

    // Follow-up question wording, so each reads naturally for its path.
    const FOLLOWUP_PHRASE: Record<string, string> = {
      "implementar com IA": "ao implementar IA",
      "agência ou freelancer": "com a agência ou freelancer",
      "contratar equipe": "ao contratar equipe",
      "fornecedor/parceiro": "com o fornecedor/parceiro",
      consultoria: "com a consultoria",
    };

    // "I tried nothing" is not an option here: the secondary "ainda não
    // tentei" button clears every tick and moves on (see below).
    const caminhosBoxes = Array.from(
      stepCaminhos.querySelectorAll<HTMLInputElement>('input[name="caminhos"]')
    );

    // Tracks the actual order paths were ticked in (not DOM order), seeded
    // from any restored answers so a refresh keeps the original order.
    let caminhosClickOrder: string[] = [...answers.caminhos];

    caminhosBoxes.forEach((box) => {
      box.addEventListener("change", () => {
        if (box.checked) {
          if (!caminhosClickOrder.includes(box.value)) caminhosClickOrder.push(box.value);
        } else {
          caminhosClickOrder = caminhosClickOrder.filter((v) => v !== box.value);
        }
      });
    });

    function tickedCaminhos(): string[] {
      const checkedNow = new Set(caminhosBoxes.filter((b) => b.checked).map((b) => b.value));
      return caminhosClickOrder.filter((v) => checkedNow.has(v));
    }

    function pathsNeedingFollowup(): string[] {
      const ticked = tickedCaminhos();
      return ticked.slice(0, 2);
    }

    // A follow-up slot is reused for whichever path currently sits in it. When
    // the path changes, drop the previous path's selection and preload the one
    // saved for the new path, so an answer is never attributed to another path.
    function bindSlot(step: HTMLFieldSetElement, path: string, saved: Record<string, string>) {
      if (step.dataset.path === path) return;
      step.dataset.path = path;
      step.querySelectorAll<HTMLInputElement>("input").forEach((i) => (i.checked = false));
      const value = saved[path];
      if (value) {
        const r = step.querySelector<HTMLInputElement>(`input[value="${CSS.escape(value)}"]`);
        if (r) r.checked = true;
      }
    }

    // Build the active step order fresh each time -- the follow-up count
    // depends on how many paths are ticked, which can change on back-nav.
    // When a persona page prefilled "dor", that step is skipped entirely.
    function buildOrder(): HTMLFieldSetElement[] {
      const order = prefilledDor ? [stepFase, stepCaminhos] : [stepFase, stepDor, stepCaminhos];
      const paths = pathsNeedingFollowup();
      paths.forEach((path, i) => {
        const outcome = FOLLOWUP_STEPS[i];
        const retorno = RETORNO_STEPS[i];
        bindSlot(outcome, path, answers.seguimentos);
        bindSlot(retorno, path, answers.retornos);
        outcome.querySelector<HTMLElement>(".followupPath")!.textContent = FOLLOWUP_PHRASE[path] ?? `com ${path}`;
        order.push(outcome, retorno);
      });
      order.push(stepPares, stepValor);
      return order;
    }

    const ALL_STEPS = [
      stepFase,
      stepDor,
      stepCaminhos,
      stepSeguimento0,
      stepRetorno0,
      stepSeguimento1,
      stepRetorno1,
      stepPares,
      stepValor,
    ];

    let order = buildOrder();
    let currentIndex = 0;

    function syncCaminhosRequired() {
      const anyChecked = caminhosBoxes.some((b) => b.checked);
      caminhosBoxes.forEach((b) => (b.required = !anyChecked));
    }
    syncCaminhosRequired();
    caminhosBoxes.forEach((b) => b.addEventListener("change", syncCaminhosRequired));

    // Pains: up to two, in click order (the first is the main one).
    // "não sei por onde começar" combines with another pain like any other
    // option, but it only makes sense pre-launch -- once the business runs
    // the visitor already knows where it hurts -- so it is hidden for every
    // fase but the first.
    const dorBoxes = Array.from(stepDor.querySelectorAll<HTMLInputElement>('input[name="dor"]'));
    let dorClickOrder: string[] = [...answers.dores];

    function tickedDores(): string[] {
      const checkedNow = new Set(dorBoxes.filter((b) => b.checked).map((b) => b.value));
      return dorClickOrder.filter((v) => checkedNow.has(v));
    }

    // Required until one is ticked; once two are ticked the rest lock.
    function syncDorState() {
      const n = tickedDores().length;
      dorBoxes.forEach((b) => {
        b.required = n === 0;
        b.disabled = n >= 2 && !b.checked;
      });
    }

    dorBoxes.forEach((box) => {
      box.addEventListener("change", () => {
        if (box.checked) {
          if (!dorClickOrder.includes(box.value)) dorClickOrder.push(box.value);
        } else {
          dorClickOrder = dorClickOrder.filter((v) => v !== box.value);
        }
        syncDorState();
      });
    });

    function syncDorOptionsForFase() {
      const fase = (form.querySelector('input[name="fase"]:checked') as HTMLInputElement | null)?.value ?? null;
      dorBoxes.forEach((input) => {
        const label = input.closest("label") as HTMLLabelElement | null;
        const faseOnly = label?.dataset.faseOnly;
        if (!label || !faseOnly) return;
        const allowed = fase === faseOnly;
        label.hidden = !allowed;
        if (!allowed && input.checked) {
          input.checked = false;
          dorClickOrder = dorClickOrder.filter((v) => v !== input.value);
        }
      });
      syncDorState();
    }
    syncDorOptionsForFase();

    // "outra coisa..." is typeable -- its real answer is the free-text
    // value, not the literal radio value, and the field only matters
    // (visible + required) while that radio is the one checked.
    const valorOutroField = stepValor.querySelector<HTMLElement>(".valorOutroField")!;
    const valorOutroInput = stepValor.querySelector<HTMLInputElement>('input[name="valorOutro"]')!;
    function syncValorOutro() {
      const checked = (form.querySelector('input[name="valor"]:checked') as HTMLInputElement | null)?.value ?? null;
      const show = checked === "outra";
      valorOutroField.hidden = !show;
      valorOutroInput.required = show;
      if (!show) valorOutroInput.value = "";
    }
    syncValorOutro();

    function showStep(index: number) {
      order.forEach((step, i) => {
        step.hidden = i !== index;
        const nav = step.querySelector<HTMLElement>(".navRow");
        if (nav) nav.hidden = false;
        const back = step.querySelector<HTMLElement>(".btnBack");
        if (back) back.hidden = index === 0;
      });
      progressShell.hidden = false;
      progressFill.style.width = `${((index + 1) / order.length) * 100}%`;
      progressLabel.textContent = `Pergunta ${index + 1} de ${order.length}`;
      order[index].scrollIntoView({ behavior: "smooth", block: "start" });
    }

    function stepIsValid(step: HTMLFieldSetElement): boolean {
      const controls = Array.from(step.querySelectorAll<HTMLInputElement>("input"));
      const firstInvalid = controls.find((c) => !c.checkValidity());
      if (firstInvalid) {
        firstInvalid.reportValidity();
        return false;
      }
      return true;
    }

    // Reads every field currently in the DOM into `answers` and persists it.
    // Called on every form change (not just on "continuar") so a stray
    // refresh never loses a selection the visitor already made.
    function syncAllAnswersFromDom() {
      answers.fase = (form.querySelector('input[name="fase"]:checked') as HTMLInputElement | null)?.value ?? null;
      if (!prefilledDor) answers.dores = tickedDores();
      answers.caminhos = tickedCaminhos();
      // Dropped paths lose their stale follow-up answer.
      Object.keys(answers.seguimentos).forEach((p) => {
        if (!answers.caminhos.includes(p)) delete answers.seguimentos[p];
      });
      FOLLOWUP_STEPS.forEach((step) => {
        const path = step.dataset.path;
        const val = (step.querySelector('input:checked') as HTMLInputElement | null)?.value;
        if (path && val && answers.caminhos.includes(path)) answers.seguimentos[path] = val;
      });
      Object.keys(answers.retornos).forEach((p) => {
        if (!answers.caminhos.includes(p)) delete answers.retornos[p];
      });
      RETORNO_STEPS.forEach((step) => {
        const path = step.dataset.path;
        const val = (step.querySelector('input:checked') as HTMLInputElement | null)?.value;
        if (path && val && answers.caminhos.includes(path)) answers.retornos[path] = val;
      });
      answers.pares = (form.querySelector('input[name="pares"]:checked') as HTMLInputElement | null)?.value ?? null;
      const valorChecked = (form.querySelector('input[name="valor"]:checked') as HTMLInputElement | null)?.value ?? null;
      answers.valor = valorChecked === "outra" ? valorOutroInput.value.trim() || null : valorChecked;
      saveAnswers(answers);
    }

    let submissionId: string | null = null;
    let createPayload: Record<string, unknown> | null = null;
    let lastDiagnostico: Diagnostico | null = null;

    // The create call can fail at the end of the quiz (offline, cold start).
    // Keep the payload so the confirm/waitlist step can retry it instead of
    // silently dropping the lead.
    async function ensureSubmission(): Promise<boolean> {
      if (submissionId) return true;
      if (!createPayload) return false;
      submissionId = await createSubmission(createPayload);
      return submissionId !== null;
    }

    // The create call takes a moment, during which "concluir" is still
    // clickable; without this a double-click files two submissions.
    let finishing = false;

    async function finishQuiz() {
      if (finishing) return;
      syncAllAnswersFromDom();
      if (!answers.fase || !answers.dores.length || !answers.valor) return;
      finishing = true;

      const [dorPrincipal, dorSecundaria] = answers.dores;
      const diagnostico = computeDiagnostico(dorPrincipal, answers.fase);
      lastDiagnostico = diagnostico;
      const diagnosticoTexto = diagnostico.inNetwork
        ? `${diagnostico.significado} ${diagnostico.primeiroPasso}`
        : "fora de rede";

      createPayload = {
        fase: answers.fase,
        dor: answers.dores.join(" + "),
        caminhos: answers.caminhos,
        // Peer talks and the investment verdict ride in the same map as the
        // per-path outcomes (the backend stores any short key/value pairs).
        seguimentos: {
          ...answers.seguimentos,
          ...(answers.pares ? { "conversei com outros empreendedores": answers.pares } : {}),
          ...Object.fromEntries(
            Object.entries(answers.retornos).map(([path, v]) => [`retorno do investimento: ${path}`, v]),
          ),
        },
        valor: answers.valor,
        diagnosticoTexto,
        inNetwork: diagnostico.inNetwork,
        ...utmContext,
      };
      submissionId = await createSubmission(createPayload);

      quizSection!.hidden = true;
      renderDiagnostico(diagnostico, dorPrincipal, dorSecundaria);
    }

    ALL_STEPS.forEach((step) => {
      const nextBtn = step.querySelector<HTMLButtonElement>(".btnNext");
      const backBtn = step.querySelector<HTMLButtonElement>(".btnBack");
      nextBtn?.addEventListener("click", () => {
        if (!stepIsValid(step)) return;
        syncAllAnswersFromDom();
        if (step === stepCaminhos) {
          // Rebuild order now that the follow-up count is known.
          order = buildOrder();
          currentIndex = order.indexOf(stepCaminhos) + 1;
        } else {
          currentIndex = Math.min(currentIndex + 1, order.length - 1);
        }
        if (step === stepValor) {
          finishQuiz();
          return;
        }
        showStep(currentIndex);
      });
      backBtn?.addEventListener("click", () => {
        currentIndex = Math.max(currentIndex - 1, 0);
        order = buildOrder();
        showStep(currentIndex);
      });
    });

    // "ainda não tentei": no paths ticked, so no follow-up questions.
    stepCaminhos.querySelector<HTMLButtonElement>(".btnSkip")?.addEventListener("click", () => {
      caminhosBoxes.forEach((b) => (b.checked = false));
      caminhosClickOrder = [];
      syncCaminhosRequired();
      syncAllAnswersFromDom();
      order = buildOrder();
      currentIndex = order.indexOf(stepCaminhos) + 1;
      showStep(currentIndex);
    });

    // Persist on every change, not just on "continuar" -- a selection
    // should survive a refresh even before the visitor advances.
    form.addEventListener("change", () => {
      syncDorOptionsForFase();
      syncValorOutro();
      syncAllAnswersFromDom();
    });

    btnStart?.addEventListener("click", () => {
      quizSection.hidden = false;
      order = buildOrder();
      currentIndex = 0;
      showStep(0);
    });

    // Restore from sessionStorage so a refresh mid-quiz doesn't lose
    // answers: re-check the matching inputs, then resume at the first
    // step that isn't answered yet.
    function restoreFromAnswers() {
      const hasAnyProgress =
        answers.fase || (!prefilledDor && answers.dores.length) || answers.caminhos.length || answers.valor;
      if (!hasAnyProgress) return;

      if (answers.fase) {
        const r = form.querySelector(`input[name="fase"][value="${CSS.escape(answers.fase)}"]`) as HTMLInputElement | null;
        if (r) r.checked = true;
      }
      if (!prefilledDor) {
        answers.dores.forEach((d) => {
          const r = form.querySelector(`input[name="dor"][value="${CSS.escape(d)}"]`) as HTMLInputElement | null;
          if (r) r.checked = true;
        });
      }
      syncDorOptionsForFase();
      caminhosBoxes.forEach((b) => {
        b.checked = answers.caminhos.includes(b.value);
      });
      syncCaminhosRequired();

      order = buildOrder();
      // (follow-up and investment slots are preloaded by buildOrder above)
      if (answers.pares) {
        const r = form.querySelector(`input[name="pares"][value="${CSS.escape(answers.pares)}"]`) as HTMLInputElement | null;
        if (r) r.checked = true;
      }
      if (answers.valor) {
        const r = form.querySelector(`input[name="valor"][value="${CSS.escape(answers.valor)}"]`) as HTMLInputElement | null;
        if (r) {
          r.checked = true;
        } else {
          // Saved value doesn't match any fixed option -- it's a restored
          // "outra coisa..." free-text answer.
          const outra = form.querySelector('input[name="valor"][value="outra"]') as HTMLInputElement | null;
          if (outra) {
            outra.checked = true;
            valorOutroInput.value = answers.valor;
          }
        }
      }
      syncValorOutro();

      // Resume at the first step in the (now rebuilt) order that has no
      // saved answer yet.
      const firstIncomplete = order.findIndex((step) => {
        if (step === stepFase) return !answers.fase;
        if (step === stepDor) return !answers.dores.length;
        if (step === stepCaminhos) return !answers.caminhos.length;
        if (step === stepSeguimento0 || step === stepSeguimento1) {
          const path = step.dataset.path;
          return path ? !answers.seguimentos[path] : true;
        }
        if (step === stepRetorno0 || step === stepRetorno1) {
          const path = step.dataset.path;
          return path ? !answers.retornos[path] : true;
        }
        if (step === stepPares) return !answers.pares;
        if (step === stepValor) return !answers.valor;
        return false;
      });

      quizSection.hidden = false;
      currentIndex = firstIncomplete === -1 ? order.length - 1 : firstIncomplete;
      showStep(currentIndex);
    }

    restoreFromAnswers();

    // ---- Diagnostic, tiers, confirmation (Phase 3-5) ----
    const diagnosticoSection = document.getElementById("diagnostico")!;
    const diagEmRede = document.getElementById("diagnosticoEmRede")!;
    const diagForaDeRede = document.getElementById("diagnosticoForaDeRede")!;
    const diagTitulo = document.getElementById("diagTitulo")!;
    const diagSignificado = document.getElementById("diagSignificado")!;
    const diagPasso = document.getElementById("diagPasso")!;
    const diagSecundaria = document.getElementById("diagSecundaria")!;
    const tiersSection = document.getElementById("tiers")!;
    const waitlistSection = document.getElementById("waitlist")!;
    const confirmacaoSection = document.getElementById("confirmacao")!;
    const obrigadoSection = document.getElementById("obrigado")!;

    function renderDiagnostico(diag: Diagnostico, dor: string, dorSecundaria?: string) {
      diagnosticoSection.hidden = false;
      if (diag.inNetwork) {
        diagEmRede.hidden = false;
        diagForaDeRede.hidden = true;
        diagTitulo.textContent = dor;
        diagSecundaria.hidden = !dorSecundaria;
        diagSecundaria.textContent = dorSecundaria ? `você também marcou: ${dorSecundaria}.` : "";
        diagSignificado.textContent = diag.significado;
        diagPasso.textContent = diag.primeiroPasso;
      } else {
        diagEmRede.hidden = true;
        diagForaDeRede.hidden = false;
      }
      diagnosticoSection.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    // ---- "organize com a sua IA": a prompt the visitor takes to their own AI ----
    // Minimal on purpose: only what a generic AI would not know (the visitor's
    // context and our point of view); the AI handles the rest on its own.
    function triedSummary(): string {
      if (!answers.caminhos.length) return "nada até agora";
      return answers.caminhos
        .map((c) => (answers.seguimentos[c] ? `${c} (${answers.seguimentos[c]})` : c))
        .join("; ");
    }

    function promptContext(): string {
      const pains =
        answers.dores.length > 1 ? `${answers.dores[0]} (principal) e ${answers.dores[1]}` : answers.dores[0];
      const retornos = Object.entries(answers.retornos);
      const investido = retornos.length
        ? `; sobre o que investi (tempo e dinheiro) em cada caminho: ${retornos.map(([p, v]) => `${p}: ${v}`).join("; ")}`
        : "";
      const pares = answers.pares ? `; conversas com outros empreendedores: ${answers.pares}` : "";
      return `contexto do meu negócio: fase: ${answers.fase}; maior trava: ${pains}; já tentei: ${triedSummary()}${investido}${pares}; o que mais ajudaria agora: ${answers.valor}.`;
    }

    function buildCaixaPrompt(): string {
      return [
        `${promptContext()} vou anexar (ou colar) os extratos e anotações dos últimos 30 dias.`,
        "",
        "comece com uma frase sobre como está o caixa. depois, em até uma página:",
        "1. para onde o dinheiro foi: as 5 maiores categorias de saída, com o percentual sobre as saídas do negócio (a retirada do dono, os gastos pessoais pagos pelo negócio e as transferências entre contas minhas ficam de fora e aparecem à parte).",
        "2. os 3 gastos que eu revisaria primeiro, cada um com a ação concreta e o ajuste possível em reais por mês (se não houver base, dê uma faixa e diga que é estimativa).",
        "3. o resultado do mês antes e depois da retirada do dono, e quantos dias de caixa eu tenho: caixa livre (saldo + dinheiro em mãos − faturas e boletos a vencer) dividido pela saída média diária do negócio (sem a retirada do dono), calculada pelos dias que os extratos realmente cobrem, sem contar vendas futuras.",
        "4. uma ação para esta semana e um número para acompanhar toda segunda-feira.",
        "5. o que você assumiu ou não conseguiu confirmar.",
        "",
        "se faltar algo que mude a resposta, entregue o que der com suposições declaradas e faça até 3 perguntas curtas ao final do item 5.",
        "",
        'depois disso, termine com um "resumo para guardar", em texto simples e sem tabelas, com estas linhas: data de hoje, resultado do mês, caixa livre, dias de caixa e ação desta semana. no mês que vem vou voltar com este resumo e novos extratos para comparar.',
        "",
        "não sugira cortar um gasto que gera venda sem avaliar o retorno. não repita CPF, CNPJ nem números de conta.",
      ].join("\n");
    }

    function buildGenericPrompt(): string {
      const d = lastDiagnostico && lastDiagnostico.inNetwork ? lastDiagnostico : null;
      return [
        `${promptContext()}${d ? ` leitura inicial da nami.works: ${d.significado} primeiro passo sugerido: ${d.primeiroPasso}` : ""}`,
        "",
        "me ajude a organizar os próximos passos. comece com uma frase sobre onde estou. depois, em até uma página:",
        "1. as 3 prioridades dos próximos 14 dias, cada uma com a ação concreta, o prazo e como saber se funcionou.",
        "2. o que eu não devo fazer agora.",
        "3. uma ação para esta semana e um número para acompanhar toda segunda-feira.",
        "4. o que você assumiu ou não conseguiu confirmar.",
        "",
        "se faltar algo que mude a resposta, entregue o que der com suposições declaradas e faça até 3 perguntas curtas ao final do item 4.",
        "",
        'depois disso, termine com um "resumo para guardar", em texto simples e sem tabelas, com estas linhas: data de hoje, prioridades e ação desta semana. no mês que vem vou voltar com este resumo para comparar.',
        "",
        "não peça nem repita documentos pessoais.",
      ].join("\n");
    }

    function showAiPrompt() {
      const isCaixa = answers.dores[0] === "caixa e finanças";
      const textarea = document.getElementById("aiPromptText") as HTMLTextAreaElement;
      textarea.value = isCaixa ? buildCaixaPrompt() : buildGenericPrompt();

      const steps = [
        "copie o texto e cole numa conversa nova na sua IA.",
        ...(isCaixa
          ? ["anexe os extratos dos últimos 30 dias na mesma conversa, ou cole o texto deles logo abaixo do prompt."]
          : []),
        'guarde o "resumo para guardar" que vem no fim da resposta (nas suas notas, por exemplo). no mês que vem, cole ele de volta na conversa para comparar.',
      ];
      const list = document.getElementById("aiPromptSteps")!;
      list.replaceChildren(
        ...steps.map((s) => {
          const li = document.createElement("li");
          li.textContent = s;
          return li;
        }),
      );

      document.getElementById("aiPromptNote")!.textContent = isCaixa
        ? "os arquivos vão só para a sua IA, nunca para a nami.works. antes de enviar, apague CPF, CNPJ e números de conta. a IA pode errar a leitura de valores: confira os totais antes de decidir."
        : "não inclua dados pessoais ou de clientes na conversa. confira o que a IA sugerir antes de decidir.";

      document.getElementById("aiPromptCopied")!.textContent = "";
      document.getElementById("aiPrompt")!.hidden = false;
    }

    document.getElementById("btnCopiarPrompt")?.addEventListener("click", async () => {
      const textarea = document.getElementById("aiPromptText") as HTMLTextAreaElement;
      const flag = document.getElementById("aiPromptCopied")!;
      let ok = false;
      try {
        await navigator.clipboard.writeText(textarea.value);
        ok = true;
      } catch {
        textarea.select();
        try {
          ok = document.execCommand("copy");
        } catch {
          /* no-op */
        }
      }
      flag.textContent = ok ? "copiado" : "não deu para copiar: selecione o texto e copie manualmente";
    });

    document.getElementById("btnVerTiers")?.addEventListener("click", () => {
      diagnosticoSection.hidden = true;
      renderTiers();
      tiersSection.hidden = false;
      tiersSection.scrollIntoView({ behavior: "smooth", block: "start" });
    });

    document.getElementById("btnMeAvise")?.addEventListener("click", () => {
      diagnosticoSection.hidden = true;
      waitlistSection.hidden = false;
      waitlistSection.scrollIntoView({ behavior: "smooth", block: "start" });
    });

    // ---- Tiers ----
    let tierEscolhido: string | null = null;
    let tierRecomendado: string | null = null;

    function renderTiers() {
      const recomendados = recommendTiers(answers);
      tierRecomendado = recomendados[0] ?? null;
      const mencao = recomendados[1];

      const cards = Array.from(tiersSection.querySelectorAll<HTMLButtonElement>(".tierCard"));
      cards.forEach((card) => {
        const isRecomendado = card.dataset.tier === tierRecomendado;
        const tag = card.querySelector<HTMLElement>(".tierRecomendado")!;
        tag.hidden = !isRecomendado;
        card.classList.toggle("tierCardRecomendado", isRecomendado);
      });

      // Why this tier, when how the peer conversations went is the reason.
      const motivoEl = document.getElementById("tierMotivo")!;
      let motivo = "";
      if (tierRecomendado === "Colega" && answers.pares === "sim, e ajudou") {
        motivo =
          "você já viu como conversar com outros empreendedores ajuda. o próximo passo é falar com alguém que já resolveu exatamente o que trava o seu negócio.";
      } else if (tierRecomendado !== "Colega" && answers.pares === "sim, mas não ajudou") {
        motivo =
          "conversas informais nem sempre bastam. aqui, a conversa é com um profissional com experiência no seu tema, e sai com direção prática.";
      } else if (tierRecomendado === "Sênior" && answers.pares === "sim, e ajudou em parte") {
        motivo =
          "se as conversas com outros empreendedores ajudaram em parte, um profissional pode cobrir o que ficou faltando.";
      }
      motivoEl.hidden = !motivo;
      motivoEl.textContent = motivo;

      const mencaoEl = document.getElementById("tierMencao")!;
      if (mencao) {
        mencaoEl.hidden = false;
        mencaoEl.textContent = `${mencao} também pode fazer sentido pra você.`;
      } else {
        mencaoEl.hidden = true;
      }
    }

    tiersSection.querySelectorAll<HTMLButtonElement>(".tierCard").forEach((card) => {
      card.addEventListener("click", () => {
        tierEscolhido = card.dataset.tier ?? null;
        tiersSection.querySelectorAll<HTMLButtonElement>(".tierCard").forEach((c) => {
          c.classList.toggle("tierCardSelecionado", c === card);
        });
        const btn = document.getElementById("btnVerConfirmacao") as HTMLButtonElement | null;
        if (btn) btn.disabled = false;
      });
    });

    document.getElementById("btnVerConfirmacao")?.addEventListener("click", () => {
      if (!tierEscolhido) return;
      tiersSection.hidden = true;
      const resumo = document.getElementById("confirmacaoResumo")!;
      resumo.textContent = `${answers.dores.join(" + ")} · ${answers.fase} · plano ${tierEscolhido}`;
      confirmacaoSection.hidden = false;
      confirmacaoSection.scrollIntoView({ behavior: "smooth", block: "start" });
    });

    // ---- Confirmation (tier path) ----
    document.getElementById("confirmacaoForm")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const nome = (form.querySelector("#confNome") as HTMLInputElement).value;
      const telefone = (form.querySelector("#confTelefone") as HTMLInputElement).value;
      const email = (form.querySelector("#confEmail") as HTMLInputElement).value;
      const errorEl = document.getElementById("confirmacaoError")!;
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;

      errorEl.hidden = true;
      submitBtn.disabled = true;
      const ok =
        (await ensureSubmission()) &&
        (await patchSubmission(submissionId!, {
          status: "confirmed",
          tierRecomendado,
          tierEscolhido,
          nome,
          telefone,
          email,
        }));
      if (!ok) {
        errorEl.textContent = SUBMIT_ERROR;
        errorEl.hidden = false;
        submitBtn.disabled = false;
        return;
      }

      confirmacaoSection.hidden = true;
      document.getElementById("obrigadoTexto")!.textContent =
        "a gente te chama assim que encontrar a pessoa certa pra essa conversa. nada é cobrado antes de você aceitar a conexão.";
      obrigadoSection.hidden = false;
      showAiPrompt();
      obrigadoSection.scrollIntoView({ behavior: "smooth", block: "start" });
      try {
        sessionStorage.removeItem(STORAGE_KEY);
      } catch {
        /* no-op */
      }
    });

    // ---- Waitlist (out-of-network path) ----
    document.getElementById("waitlistForm")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const email = (form.querySelector("#waitlistEmail") as HTMLInputElement).value;
      const telefone = (form.querySelector("#waitlistTelefone") as HTMLInputElement).value;
      const errorEl = document.getElementById("waitlistError")!;
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;

      errorEl.hidden = true;
      submitBtn.disabled = true;
      const ok =
        (await ensureSubmission()) &&
        (await patchSubmission(submissionId!, { status: "waitlist", email, telefone }));
      if (!ok) {
        errorEl.textContent = SUBMIT_ERROR;
        errorEl.hidden = false;
        submitBtn.disabled = false;
        return;
      }

      waitlistSection.hidden = true;
      document.getElementById("obrigadoTexto")!.textContent =
        "esse tema ainda não tem ninguém no nosso time pra conversar, mas guardamos seu contato. a gente te chama assim que encontrar a pessoa certa.";
      obrigadoSection.hidden = false;
      showAiPrompt();
      obrigadoSection.scrollIntoView({ behavior: "smooth", block: "start" });
      try {
        sessionStorage.removeItem(STORAGE_KEY);
      } catch {
        /* no-op */
      }
    });
  })();
</script>

