---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/marketing.css";

// Matchmaking funnel (2026-09-30 pivot). Phase 2: quiz added.
// Copy verbatim from nami-works/matchmaking/funnel-spec.md.

const fases = [
  "ainda é uma ideia",
  "começando (promissor, precisa de estrutura)",
  "já roda, quero ganhar escala",
  "crescendo, preciso me estruturar",
];

const dores = [
  "vendas e clientes",
  "dinheiro e finanças",
  "equipe e contratação",
  "produto ou ideia",
  "marketing",
  "crescer o negócio",
  "não sei por onde começar",
];

const caminhos = [
  "resolvi sozinho",
  "perguntei pra uma IA",
  "contratei agência ou freelancer",
  "montei equipe interna",
  "busquei parcerias estratégicas",
  "contratei consultoria",
  "conversei com outros empreendedores",
  "ainda nada",
];

const resultadosCaminho = [
  "não resolveu",
  "resolveu em parte",
  "funcionou, mas não sustentou",
  "custou mais do que valia",
];

const valores = [
  "clareza",
  "validar uma decisão",
  "um caminho prático",
  "alguém que já fez",
  "uma conexão (contato ou indicação)",
  "um projeto de consultoria",
  "um conselheiro contínuo",
];
---

<BaseLayout
  title="nami.works | travou no seu negócio? tem gente que pode te ajudar"
  description="tem horas que parece ser tanta coisa, e a gente nem sabe por onde começar. trocar com quem já viveu algo parecido pode ser o caminho."
>
  <section class="hero">
    <div class="container">
      <h1 class="heroTitle display display-1">travou no seu negócio? tem gente que pode te ajudar!</h1>
      <p class="heroLede">
        tem horas que parece ser tanta coisa, e a gente nem sabe por onde começar.
      </p>
      <p class="heroLede">
        trocar com quem já viveu algo parecido pode ser o caminho.
      </p>
      <div class="ctaRow">
        <button type="button" class="ctaPrimary" id="btnStart">entenda seu problema</button>
      </div>
    </div>
  </section>

  <section class="section sectionSoft" id="quiz" hidden>
    <div class="container narrow">
      <form class="quizForm" id="quizForm">
        <div class="progressShell" hidden>
          <p class="progressLabel">Pergunta 1</p>
          <div class="progressTrack"><div class="progressFill"></div></div>
        </div>

        <fieldset class="step" data-step="fase">
          <legend class="stepLegend">em que fase está o negócio?</legend>
          <div class="chips" role="radiogroup" aria-label="em que fase está o negócio?">
            {fases.map((f) => (
              <label class="chip">
                <input type="radio" name="fase" value={f} required />
                <span>{f}</span>
              </label>
            ))}
          </div>
          <div class="navRow" hidden>
            <button type="button" class="ctaSecondary btnBack" hidden>voltar</button>
            <button type="button" class="ctaPrimary btnNext">continuar</button>
          </div>
        </fieldset>

        <fieldset class="step" data-step="dor" hidden>
          <legend class="stepLegend">onde você sente que travou?</legend>
          <div class="chips" role="radiogroup" aria-label="onde você sente que travou?">
            {dores.map((d) => (
              <label class="chip">
                <input type="radio" name="dor" value={d} required />
                <span>{d}</span>
              </label>
            ))}
          </div>
          <div class="navRow" hidden>
            <button type="button" class="ctaSecondary btnBack">voltar</button>
            <button type="button" class="ctaPrimary btnNext">continuar</button>
          </div>
        </fieldset>

        <fieldset class="step" data-step="caminhos" hidden>
          <legend class="stepLegend">quais desses caminhos você já tentou? <span class="optional">(pode marcar vários)</span></legend>
          <div class="chips" role="group" aria-label="quais desses caminhos você já tentou?" id="caminhosGroup">
            {caminhos.map((c) => (
              <label class="chip">
                <input type="checkbox" name="caminhos" value={c} />
                <span>{c}</span>
              </label>
            ))}
          </div>
          <div class="navRow" hidden>
            <button type="button" class="ctaSecondary btnBack">voltar</button>
            <button type="button" class="ctaPrimary btnNext" id="btnAfterCaminhos">continuar</button>
          </div>
        </fieldset>

        {[0, 1].map((slot) => (
          <fieldset class="step followupStep" data-step={`seguimento${slot}`} data-slot={slot} hidden>
            <legend class="stepLegend followupLegend">como foi com <span class="followupPath"></span>?</legend>
            <div class="chips" role="radiogroup">
              {resultadosCaminho.map((r) => (
                <label class="chip">
                  <input type="radio" name={`seguimento${slot}`} value={r} />
                  <span>{r}</span>
                </label>
              ))}
            </div>
            <div class="navRow" hidden>
              <button type="button" class="ctaSecondary btnBack">voltar</button>
              <button type="button" class="ctaPrimary btnNext">continuar</button>
            </div>
          </fieldset>
        ))}

        <fieldset class="step" data-step="valor" hidden>
          <legend class="stepLegend">o que tem mais valor pra você agora?</legend>
          <div class="chips" role="radiogroup" aria-label="o que tem mais valor pra você agora?">
            {valores.map((v) => (
              <label class="chip">
                <input type="radio" name="valor" value={v} required />
                <span>{v}</span>
              </label>
            ))}
          </div>
          <div class="navRow" hidden>
            <button type="button" class="ctaSecondary btnBack">voltar</button>
            <button type="button" class="ctaPrimary btnNext" id="btnVerDiagnostico">ver meu diagnóstico</button>
          </div>
        </fieldset>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  type Answers = {
    fase: string | null;
    dor: string | null;
    caminhos: string[]; // in click order
    seguimentos: Record<string, string>; // path -> outcome
    valor: string | null;
  };

  const STORAGE_KEY = "nami-quiz-state-v1";

  function emptyAnswers(): Answers {
    return { fase: null, dor: null, caminhos: [], seguimentos: {}, valor: null };
  }

  function loadAnswers(): Answers {
    try {
      const raw = sessionStorage.getItem(STORAGE_KEY);
      if (!raw) return emptyAnswers();
      const parsed = JSON.parse(raw);
      return { ...emptyAnswers(), ...parsed };
    } catch {
      return emptyAnswers();
    }
  }

  function saveAnswers(a: Answers) {
    try {
      sessionStorage.setItem(STORAGE_KEY, JSON.stringify(a));
    } catch {
      /* private mode / storage disabled, no-op */
    }
  }

  (function () {
    const quizSection = document.getElementById("quiz");
    const btnStart = document.getElementById("btnStart");
    const form = document.getElementById("quizForm") as HTMLFormElement | null;
    if (!quizSection || !btnStart || !form) return;

    const answers = loadAnswers();

    const stepFase = form.querySelector<HTMLFieldSetElement>('[data-step="fase"]')!;
    const stepDor = form.querySelector<HTMLFieldSetElement>('[data-step="dor"]')!;
    const stepCaminhos = form.querySelector<HTMLFieldSetElement>('[data-step="caminhos"]')!;
    const stepSeguimento0 = form.querySelector<HTMLFieldSetElement>('[data-step="seguimento0"]')!;
    const stepSeguimento1 = form.querySelector<HTMLFieldSetElement>('[data-step="seguimento1"]')!;
    const stepValor = form.querySelector<HTMLFieldSetElement>('[data-step="valor"]')!;
    const progressShell = form.querySelector<HTMLElement>(".progressShell")!;
    const progressFill = form.querySelector<HTMLElement>(".progressFill")!;
    const progressLabel = form.querySelector<HTMLElement>(".progressLabel")!;

    const FOLLOWUP_STEPS = [stepSeguimento0, stepSeguimento1];

    // "ainda nada" is mutually exclusive with every other path: ticking it
    // clears the rest (and vice versa), since "I tried nothing" contradicts
    // "I tried X".
    const caminhosBoxes = Array.from(
      stepCaminhos.querySelectorAll<HTMLInputElement>('input[name="caminhos"]')
    );
    const NADA_VALUE = "ainda nada";

    // Tracks the actual order paths were ticked in (not DOM order), seeded
    // from any restored answers so a refresh keeps the original order.
    let caminhosClickOrder: string[] = [...answers.caminhos];

    caminhosBoxes.forEach((box) => {
      box.addEventListener("change", () => {
        if (box.value === NADA_VALUE && box.checked) {
          caminhosBoxes.forEach((b) => {
            if (b !== box) b.checked = false;
          });
          caminhosClickOrder = [NADA_VALUE];
          return;
        }
        if (box.checked) {
          const nada = caminhosBoxes.find((b) => b.value === NADA_VALUE);
          if (nada) nada.checked = false;
          caminhosClickOrder = caminhosClickOrder.filter((v) => v !== NADA_VALUE);
          if (!caminhosClickOrder.includes(box.value)) caminhosClickOrder.push(box.value);
        } else {
          caminhosClickOrder = caminhosClickOrder.filter((v) => v !== box.value);
        }
      });
    });

    function tickedCaminhos(): string[] {
      const checkedNow = new Set(caminhosBoxes.filter((b) => b.checked).map((b) => b.value));
      return caminhosClickOrder.filter((v) => checkedNow.has(v));
    }

    function pathsNeedingFollowup(): string[] {
      const ticked = tickedCaminhos();
      if (ticked.length === 0 || ticked.includes(NADA_VALUE)) return [];
      return ticked.slice(0, 2);
    }

    // Build the active step order fresh each time -- the follow-up count
    // depends on how many paths are ticked, which can change on back-nav.
    function buildOrder(): HTMLFieldSetElement[] {
      const order = [stepFase, stepDor, stepCaminhos];
      const paths = pathsNeedingFollowup();
      paths.forEach((path, i) => {
        const step = FOLLOWUP_STEPS[i];
        step.dataset.path = path;
        const label = step.querySelector<HTMLElement>(".followupPath")!;
        label.textContent = path;
        order.push(step);
      });
      order.push(stepValor);
      return order;
    }

    const ALL_STEPS = [stepFase, stepDor, stepCaminhos, stepSeguimento0, stepSeguimento1, stepValor];

    let order = buildOrder();
    let currentIndex = 0;

    function syncCaminhosRequired() {
      const anyChecked = caminhosBoxes.some((b) => b.checked);
      caminhosBoxes.forEach((b) => (b.required = !anyChecked));
    }
    syncCaminhosRequired();
    caminhosBoxes.forEach((b) => b.addEventListener("change", syncCaminhosRequired));

    function showStep(index: number) {
      order.forEach((step, i) => {
        step.hidden = i !== index;
        const nav = step.querySelector<HTMLElement>(".navRow");
        if (nav) nav.hidden = false;
        const back = step.querySelector<HTMLElement>(".btnBack");
        if (back) back.hidden = index === 0;
      });
      progressShell.hidden = false;
      progressFill.style.width = `${((index + 1) / order.length) * 100}%`;
      progressLabel.textContent = `Pergunta ${index + 1} de ${order.length}`;
      order[index].scrollIntoView({ behavior: "smooth", block: "start" });
    }

    function stepIsValid(step: HTMLFieldSetElement): boolean {
      const controls = Array.from(step.querySelectorAll<HTMLInputElement>("input"));
      const firstInvalid = controls.find((c) => !c.checkValidity());
      if (firstInvalid) {
        firstInvalid.reportValidity();
        return false;
      }
      return true;
    }

    // Reads every field currently in the DOM into `answers` and persists it.
    // Called on every form change (not just on "continuar") so a stray
    // refresh never loses a selection the visitor already made.
    function syncAllAnswersFromDom() {
      answers.fase = (form.querySelector('input[name="fase"]:checked') as HTMLInputElement | null)?.value ?? null;
      answers.dor = (form.querySelector('input[name="dor"]:checked') as HTMLInputElement | null)?.value ?? null;
      answers.caminhos = tickedCaminhos();
      // Dropped paths lose their stale follow-up answer.
      Object.keys(answers.seguimentos).forEach((p) => {
        if (!answers.caminhos.includes(p)) delete answers.seguimentos[p];
      });
      FOLLOWUP_STEPS.forEach((step) => {
        const path = step.dataset.path;
        const val = (step.querySelector('input:checked') as HTMLInputElement | null)?.value;
        if (path && val) answers.seguimentos[path] = val;
      });
      answers.valor = (form.querySelector('input[name="valor"]:checked') as HTMLInputElement | null)?.value ?? null;
      saveAnswers(answers);
    }

    ALL_STEPS.forEach((step) => {
      const nextBtn = step.querySelector<HTMLButtonElement>(".btnNext");
      const backBtn = step.querySelector<HTMLButtonElement>(".btnBack");
      nextBtn?.addEventListener("click", () => {
        if (!stepIsValid(step)) return;
        syncAllAnswersFromDom();
        if (step === stepCaminhos) {
          // Rebuild order now that the follow-up count is known.
          order = buildOrder();
          currentIndex = order.indexOf(stepCaminhos) + 1;
        } else {
          currentIndex = Math.min(currentIndex + 1, order.length - 1);
        }
        if (currentIndex >= order.length - 1 && step === stepValor) {
          // Reached the end -- Phase 3 wires the diagnostic here.
          return;
        }
        showStep(currentIndex);
      });
      backBtn?.addEventListener("click", () => {
        currentIndex = Math.max(currentIndex - 1, 0);
        order = buildOrder();
        showStep(currentIndex);
      });
    });

    // Persist on every change, not just on "continuar" -- a selection
    // should survive a refresh even before the visitor advances.
    form.addEventListener("change", () => syncAllAnswersFromDom());

    btnStart?.addEventListener("click", () => {
      quizSection.hidden = false;
      order = buildOrder();
      currentIndex = 0;
      showStep(0);
    });

    // Restore from sessionStorage so a refresh mid-quiz doesn't lose
    // answers: re-check the matching inputs, then resume at the first
    // step that isn't answered yet.
    function restoreFromAnswers() {
      const hasAnyProgress =
        answers.fase || answers.dor || answers.caminhos.length || answers.valor;
      if (!hasAnyProgress) return;

      if (answers.fase) {
        const r = form.querySelector(`input[name="fase"][value="${CSS.escape(answers.fase)}"]`) as HTMLInputElement | null;
        if (r) r.checked = true;
      }
      if (answers.dor) {
        const r = form.querySelector(`input[name="dor"][value="${CSS.escape(answers.dor)}"]`) as HTMLInputElement | null;
        if (r) r.checked = true;
      }
      caminhosBoxes.forEach((b) => {
        b.checked = answers.caminhos.includes(b.value);
      });
      syncCaminhosRequired();

      order = buildOrder();
      order.forEach((step) => {
        if (step === stepSeguimento0 || step === stepSeguimento1) {
          const path = step.dataset.path;
          const saved = path ? answers.seguimentos[path] : undefined;
          if (saved) {
            const r = step.querySelector(`input[value="${CSS.escape(saved)}"]`) as HTMLInputElement | null;
            if (r) r.checked = true;
          }
        }
      });
      if (answers.valor) {
        const r = form.querySelector(`input[name="valor"][value="${CSS.escape(answers.valor)}"]`) as HTMLInputElement | null;
        if (r) r.checked = true;
      }

      // Resume at the first step in the (now rebuilt) order that has no
      // saved answer yet.
      const firstIncomplete = order.findIndex((step) => {
        if (step === stepFase) return !answers.fase;
        if (step === stepDor) return !answers.dor;
        if (step === stepCaminhos) return !answers.caminhos.length;
        if (step === stepSeguimento0 || step === stepSeguimento1) {
          const path = step.dataset.path;
          return path ? !answers.seguimentos[path] : true;
        }
        if (step === stepValor) return !answers.valor;
        return false;
      });

      quizSection.hidden = false;
      currentIndex = firstIncomplete === -1 ? order.length - 1 : firstIncomplete;
      showStep(currentIndex);
    }

    restoreFromAnswers();
  })();
</script>

<style>
  .hero {
    min-height: 100dvh;
    display: flex;
    align-items: center;
    padding: 96px 0 56px;
  }

  .heroTitle {
    color: var(--site-text);
    margin: 0 0 20px;
    max-width: 680px;
  }

  .heroLede {
    font-size: 17px;
    line-height: 1.6;
    color: var(--site-text-secondary);
    max-width: 560px;
    margin: 0 0 12px;
  }

  .heroLede:last-of-type {
    margin-bottom: 28px;
  }

  .container.narrow {
    max-width: 640px;
  }

  .quizForm {
    display: grid;
    gap: 8px;
  }

  fieldset.step[hidden],
  .navRow[hidden],
  .btnBack[hidden] {
    display: none;
  }

  fieldset.step {
    display: grid;
    gap: 20px;
    border: none;
    margin: 0;
    padding: 0;
    min-width: 0;
    scroll-margin-top: 88px;
  }

  .stepLegend {
    font-size: 18px;
    font-weight: 700;
    color: var(--site-text);
    letter-spacing: -0.01em;
    padding: 0;
    margin: 0;
  }

  .optional {
    font-weight: 400;
    font-size: 14px;
    color: var(--site-text-secondary);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--site-text-secondary);
    background: var(--site-bg);
    color: var(--site-text);
    border-radius: 999px;
    padding: 10px 16px;
    font-size: 14px;
    cursor: pointer;
    user-select: none;
    min-height: 44px;
    transition: border-color 0.14s ease, background 0.14s ease, color 0.14s ease;
  }

  .chip input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    opacity: 0;
  }

  .chip:hover {
    border-color: var(--site-accent);
  }

  .chip:has(input:checked) {
    background: var(--site-accent);
    color: var(--site-accent-text);
    border-color: var(--site-accent);
  }

  .chip:has(input:focus-visible) {
    outline: 2px solid var(--site-accent);
    outline-offset: 2px;
  }

  .progressShell {
    margin: 0 0 8px;
  }

  .progressLabel {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--site-text-secondary);
    margin: 0 0 8px;
  }

  .progressTrack {
    height: 5px;
    background: var(--site-surface);
    border-radius: 999px;
    overflow: hidden;
  }

  .progressFill {
    height: 100%;
    width: 0%;
    background: var(--site-accent);
    border-radius: 999px;
    transition: width 0.3s ease;
  }

  .navRow {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .navRow .btnBack {
    background: none;
    border: none;
    padding: 4px 0;
    cursor: pointer;
    color: var(--site-text-secondary);
  }

  .followupLegend .followupPath {
    color: var(--site-accent);
  }

  @media (min-width: 769px) {
    .hero {
      padding: 140px 0 88px;
    }
    .heroLede {
      font-size: 19px;
    }
  }
</style>
