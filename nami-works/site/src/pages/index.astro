---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/marketing.css";
import MatchmakingFunnel from "../components/MatchmakingFunnel.astro";

// Matchmaking funnel (2026-09-30 pivot). Generic entry point: no persona
// prefill. Copy verbatim from nami-works/matchmaking/funnel-spec.md.
---

<BaseLayout
  title="nami.works | travou no seu negócio? a gente te conecta com quem pode ajudar"
  description="tem horas que é tanta coisa, e a gente nem sabe por onde começar. dividir as dúvidas com quem pode ajudar muitas vezes é o melhor caminho."
>
  <section class="hero">
    <div class="container">
      <h1 class="heroTitle display display-1">travou no seu negócio? a gente te conecta com quem pode ajudar!</h1>
      <p class="heroLede">
        tem horas que é tanta coisa, e a gente nem sabe por onde começar.
      </p>
      <p class="heroLede">
        dividir as dúvidas com quem pode ajudar muitas vezes é o melhor caminho.
      </p>
      <p class="heroLede">
        nos conte um pouco mais, e vamos te conectar.
      </p>
      <div class="ctaRow">
        <button type="button" class="ctaPrimary" id="btnStart">explique seu problema</button>
      </div>
    </div>
  </section>

  <MatchmakingFunnel />
</BaseLayout>

<style>
  .hero {
    min-height: 100dvh;
    display: flex;
    align-items: center;
    padding: 96px 0 56px;
  }

  .heroTitle {
    color: var(--site-text);
    margin: 0 0 20px;
    max-width: 680px;
  }

  .heroLede {
    font-size: 17px;
    line-height: 1.6;
    color: var(--site-text-secondary);
    max-width: 560px;
    margin: 0 0 12px;
  }

  .heroLede:last-of-type {
    margin-bottom: 28px;
  }

  @media (min-width: 769px) {
    .hero {
      padding: 140px 0 88px;
    }
    .heroLede {
      font-size: 19px;
    }
  }
</style>
