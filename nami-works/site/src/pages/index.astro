---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/marketing.css";
import { waLink, DIAGNOSTIC_PRICE_LABEL } from "../data/site-config";

const roleCards = [
  {
    role: "Dono",
    before: "Confere proposta, preço e estoque no fim do dia, sozinho.",
    after: "A IA já confere tudo isso. Você só aprova o que muda preço ou cliente.",
  },
  {
    role: "Financeiro",
    before: "Fecha o mês cruzando planilha com sistema, à noite.",
    after: "A IA cruza pedido, taxa e recebimento. Você confere o que não bate.",
  },
  {
    role: "Vendas",
    before: "Monta cada proposta na mão, olhando desconto por cliente.",
    after: "A IA monta a proposta dentro da sua política. Você aprova.",
  },
  {
    role: "Estoque e operação",
    before: "Descobre a ruptura quando o cliente já reclamou.",
    after: "A IA avisa antes, com o número certo pra repor.",
  },
  {
    role: "Atendimento",
    before: "Responde tudo na mão, e a fila cresce no fim do dia.",
    after: "A IA rascunha a resposta. Você revisa antes de enviar.",
  },
];

const metodoSteps = [
  { n: "01", nome: "Diagnóstico", desc: "A gente audita a operação e mostra por onde vale começar." },
  { n: "02", nome: "Piloto", desc: "30 dias, um processo só. O primeiro passo pequeno." },
  { n: "03", nome: "Implantação", desc: "O que funcionou no piloto passa pros outros processos." },
  { n: "04", nome: "Acompanhamento", desc: "A gente continua junto, todo mês, ajustando o que precisar." },
];

const seguranca = [
  { titulo: "Os dados continuam seus", desc: "Nas suas próprias contas, sempre." },
  { titulo: "Uma pessoa aprova", desc: "A IA propõe, alguém aprova antes de mudar algo de verdade." },
  { titulo: "Tudo fica registrado", desc: "Toda ação da IA fica num histórico que dá pra revisar." },
];

const waHome = waLink("Início");
---

<BaseLayout
  title="NAMI Works | Conecte seu negócio à IA, com controle"
  description="A NAMI Works conecta sua empresa à IA de forma nativa e segura: na planilha, no WhatsApp, no sistema que você já usa. Comece pelo diagnóstico."
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">NAMI Works</p>
      <h1 class="heroTitle display display-1">
        Sua empresa já roda na planilha, no WhatsApp, no e-mail. <span class="mk">A IA entra dentro disso</span>, não ao lado.
      </h1>
      <p class="heroSub">
        A gente conecta a IA aos sistemas que você já usa, com uma pessoa aprovando cada mudança que importa.
      </p>
      <div class="ctaRow">
        <a href={waHome} class="ctaPrimary" target="_blank" rel="noopener">Chamar no WhatsApp</a>
        <a href="/por-onde-comecar" class="ctaSecondary">Descobrir por onde começar</a>
      </div>
    </div>
  </section>

  <section class="section sectionSoft" id="para-voce">
    <div class="container">
      <p class="eyebrow">Um dia normal, diferente</p>
      <h2 class="sectionTitle display display-3">Cada função <span class="mk">perde tempo em um lugar diferente</span>.</h2>

      <div class="cardGrid cols3">
        {
          roleCards.map((r) => (
            <div class="card roleCard">
              <p class="cardTitle">{r.role}</p>
              <p class="roleBefore">{r.before}</p>
              <p class="roleAfter">{r.after}</p>
            </div>
          ))
        }
      </div>

      <a href="/para-quem" class="ctaSecondary">Encontrar onde começar pela sua função</a>
    </div>
  </section>

  <section class="section" id="metodo">
    <div class="container">
      <p class="eyebrow">Como funciona</p>
      <h2 class="sectionTitle display display-3">Quatro passos, <span class="mk">o piloto é o primeiro e é pequeno</span>.</h2>

      <div class="cardGrid cols2">
        {
          metodoSteps.map((s) => (
            <div class="card">
              <p class="cardNumber">{s.n}</p>
              <h3 class="cardTitle">{s.nome}</h3>
              <p class="cardBody">{s.desc}</p>
            </div>
          ))
        }
      </div>

      <a href="/como-funciona" class="ctaSecondary">Ver como funciona em detalhe</a>
    </div>
  </section>

  <section class="section sectionSoft declaracao" id="seguranca">
    <div class="container">
      <p class="eyebrow segurancaEyebrow">Segurança e controle</p>
      <h2 class="sectionTitle display display-3 segurancaTitle">Antes de perguntar, <span class="mk">a resposta</span>.</h2>

      <div class="cardGrid cols3">
        {
          seguranca.map((s) => (
            <a href="/seguranca" class="segurancaCard">
              <p class="segurancaCardTitle">{s.titulo}</p>
              <p class="segurancaCardDesc">{s.desc}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="preco">
    <div class="container">
      <p class="eyebrow">Sobre o valor</p>
      <h2 class="sectionTitle display display-3">O diagnóstico tem <span class="mk">preço público</span>.</h2>
      <p class="lede">
        {DIAGNOSTIC_PRICE_LABEL}. Piloto e acompanhamento variam com o escopo. Sem orçamento surpresa.
      </p>
      <a href="/precos" class="ctaSecondary">Ver os valores</a>
    </div>
  </section>

  <section class="section sectionSoft" id="demo">
    <div class="container">
      <p class="eyebrow">Prova</p>
      <h2 class="sectionTitle display display-3">Um agente fazendo <span class="mk">uma tarefa real</span>.</h2>
      <div class="videoPlaceholder">
        <p class="videoPlaceholderLabel">Demonstração &middot; dado inventado</p>
        <p class="videoPlaceholderNote">Vídeo em produção.</p>
      </div>
    </div>
  </section>

  <section class="section" id="comecar">
    <div class="container">
      <p class="eyebrow">Como começar</p>
      <h2 class="sectionTitle display display-3">Duas portas, <span class="mk">nenhuma é um formulário longo</span>.</h2>
      <p class="lede">
        Chama no WhatsApp pra conversar direto, ou responde o autoavaliação de alguns minutos e já sai com uma leitura.
      </p>
      <div class="ctaRow">
        <a href={waHome} class="ctaPrimary" target="_blank" rel="noopener">Chamar no WhatsApp</a>
        <a href="/por-onde-comecar" class="ctaSecondary">Descobrir por onde começar</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 56px 0 40px;
  }

  .heroTitle {
    color: var(--site-text);
    margin: 0 0 16px;
    max-width: 760px;
  }

  .heroSub {
    font-size: 17px;
    line-height: 1.55;
    color: var(--site-text-secondary);
    max-width: 560px;
    margin: 0 0 24px;
  }

  .roleCard {
    display: grid;
    gap: 8px;
  }

  .roleBefore {
    font-size: 14px;
    color: var(--site-text-secondary);
    margin: 0;
    text-decoration: line-through;
    text-decoration-color: var(--site-erro);
    text-decoration-thickness: 1px;
  }

  .roleAfter {
    font-size: 14.5px;
    color: var(--site-text);
    margin: 0;
    font-weight: 600;
  }

  /* The one legitimate pinheiro statement block on this page (canon's
     emphasis-ladder rule, max one per screen). .declaracao itself is the
     global fixed-pinheiro class from global.css (design/tokens.css) --
     literal creme-on-pinheiro regardless of site theme, not redefined here.
     Its own `.mk` override (yellow marker -> light-green word, no
     background, on this ground) already applies via that global rule. */
  .segurancaEyebrow {
    opacity: 0.75;
  }

  .segurancaCard {
    display: block;
    text-decoration: none;
    border: 1px solid rgba(250, 248, 244, 0.2);
    border-radius: 12px;
    padding: 22px;
    color: inherit;
  }

  .segurancaCardTitle {
    font-weight: 700;
    font-size: 15.5px;
    margin: 0 0 6px;
  }

  .segurancaCardDesc {
    font-size: 13.5px;
    opacity: 0.85;
    margin: 0;
  }

  .videoPlaceholder {
    border: 1px dashed var(--site-text-secondary);
    border-radius: 12px;
    padding: 48px 24px;
    text-align: center;
    max-width: 560px;
  }

  .videoPlaceholderLabel {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--site-text-secondary);
    margin: 0 0 8px;
  }

  .videoPlaceholderNote {
    font-size: 14px;
    color: var(--site-text-secondary);
    margin: 0;
  }

  @media (min-width: 769px) {
    .hero {
      padding: 120px 0 64px;
    }
    .heroSub {
      font-size: 19px;
    }
    .cardGrid.cols3 {
      grid-template-columns: repeat(3, 1fr);
    }
    .cardGrid.cols2 {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
