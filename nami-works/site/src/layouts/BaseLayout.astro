---
import "../styles/global.css";

import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  /** When true, the page paints its own header/footer, so we skip the
   *  shared Nav + Footer. Not used for v1 but kept for parity with the
   *  omnify-site pattern in case a future page needs its own chrome. */
  bareLayout?: boolean;
}

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  bareLayout = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://nami.works");
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" href="/brand/mark-goggles-ink.svg" type="image/svg+xml" />
    <link rel="icon" href="/brand/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="canonical" href={canonical.toString()} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content="https://nami.works/brand/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <script is:inline>
      // Apply theme before paint to avoid flash. Reads stored preference,
      // otherwise honors prefers-color-scheme on first visit.
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (!t) {
            t = window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
          }
          document.documentElement.setAttribute("data-theme", t);
        } catch (_) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
  </head>

  <body>
    {!bareLayout && <Nav />}
    <main style={!bareLayout ? "padding-top: 60px;" : ""}>
      <slot />
    </main>
    {!bareLayout && <Footer />}
  </body>
</html>
