# Public URL of the matchmaking Lambda Function URL (terraform output
# matchmaking_api_url in nami/site/infra/terraform). Must be PUBLIC_-prefixed
# so Astro/Vite exposes it to client-side scripts at build time.
# scripts/deploy-nami-site.ps1 sets this automatically from terraform; this
# file is only for local `npm run dev`.
PUBLIC_MATCHMAKING_API_BASE=https://REPLACE-WITH-FUNCTION-URL.lambda-url.us-east-1.on.aws
